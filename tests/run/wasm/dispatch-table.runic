// RUN: runic-opt --target wasm32-unknown-unknown %s -o %t.wasm
// RUN: wasmtime run --invoke lookup %t.wasm 10 5 2>/dev/null | filecheck %s --check-prefix=TEN
// RUN: wasmtime run --invoke lookup %t.wasm 20 5 2>/dev/null | filecheck %s --check-prefix=TWENTY
// RUN: wasmtime run --invoke lookup %t.wasm 30 5 2>/dev/null | filecheck %s --check-prefix=THIRTY
// RUN: wasmtime run --invoke lookup %t.wasm 40 5 2>/dev/null | filecheck %s --check-prefix=FORTY
// RUN: wasmtime run --invoke lookup %t.wasm 50 5 2>/dev/null | filecheck %s --check-prefix=MISS
// RUN: wasmtime run --invoke count %t.wasm 2>/dev/null | filecheck %s --check-prefix=COUNT
// RUN: wasmtime run --invoke count2 %t.wasm 2>/dev/null | filecheck %s --check-prefix=COUNT2
// RUN: wasmtime run --invoke lookup2 %t.wasm 7 2>/dev/null | filecheck %s --check-prefix=SECOND
// RUN: wasmtime run --invoke term %t.wasm 0 3 5 2>/dev/null | filecheck %s --check-prefix=ADD
// RUN: wasmtime run --invoke term %t.wasm 0 -10 5 2>/dev/null | filecheck %s --check-prefix=ADD-NEG
// RUN: wasmtime run --invoke term %t.wasm 1 3 5 2>/dev/null | filecheck %s --check-prefix=MUL
// RUN: wasmtime run --invoke term %t.wasm 1 0 5 2>/dev/null | filecheck %s --check-prefix=MUL-ZERO
// RUN: wasmtime run --invoke read %t.wasm 0 2>/dev/null | filecheck %s --check-prefix=READ-ADD
// RUN: wasmtime run --invoke read %t.wasm 1 2>/dev/null | filecheck %s --check-prefix=READ-MUL
// RUN: runic-opt --target wasm32-unknown-unknown %s -p 'canonicalizer,cse,sccp,canonicalizer,dce' -o %t.opt.wasm
// RUN: wasmtime run --invoke lookup %t.opt.wasm 10 5 2>/dev/null | filecheck %s --check-prefix=TEN
// RUN: wasmtime run --invoke lookup %t.opt.wasm 20 5 2>/dev/null | filecheck %s --check-prefix=TWENTY
// RUN: wasmtime run --invoke lookup %t.opt.wasm 30 5 2>/dev/null | filecheck %s --check-prefix=THIRTY
// RUN: wasmtime run --invoke lookup %t.opt.wasm 40 5 2>/dev/null | filecheck %s --check-prefix=FORTY
// RUN: wasmtime run --invoke lookup %t.opt.wasm 50 5 2>/dev/null | filecheck %s --check-prefix=MISS
// RUN: wasmtime run --invoke count %t.opt.wasm 2>/dev/null | filecheck %s --check-prefix=COUNT
// RUN: wasmtime run --invoke count2 %t.opt.wasm 2>/dev/null | filecheck %s --check-prefix=COUNT2
// RUN: wasmtime run --invoke lookup2 %t.opt.wasm 7 2>/dev/null | filecheck %s --check-prefix=SECOND
// RUN: wasmtime run --invoke term %t.opt.wasm 0 3 5 2>/dev/null | filecheck %s --check-prefix=ADD
// RUN: wasmtime run --invoke term %t.opt.wasm 0 -10 5 2>/dev/null | filecheck %s --check-prefix=ADD-NEG
// RUN: wasmtime run --invoke term %t.opt.wasm 1 3 5 2>/dev/null | filecheck %s --check-prefix=MUL
// RUN: wasmtime run --invoke term %t.opt.wasm 1 0 5 2>/dev/null | filecheck %s --check-prefix=MUL-ZERO
// RUN: wasmtime run --invoke read %t.opt.wasm 0 2>/dev/null | filecheck %s --check-prefix=READ-ADD
// RUN: wasmtime run --invoke read %t.opt.wasm 1 2>/dev/null | filecheck %s --check-prefix=READ-MUL

// A dispatch table in a named data section, found and called through at run time, in generic IR.
//
// Each entry is a `struct<i32, i32, (i64) -> i64>`: an id, an arity and a function, built with
// `builtin.aggregate` in the initializer of a global variable in the section `dispatch`. The
// backend evaluates each initializer to 12 bytes: the id, the arity, and the table slot of the
// function, which its data layout gives 32 bits (`fn = 32`). The four entries are not adjacent in
// the source (a global of another section and a function lie between them); the layout places
// the members of a section together, so `__start_dispatch` and `__stop_dispatch`, which the
// layout defines, bound exactly the four. `@lookup` walks from the one to the other by the entry
// size (`mem.sizeof`), compares the id, and on a match loads the function value with `mem.load`
// and calls it with `builtin.call_indirect`; a miss gives -1. `@count` is the number of entries,
// the distance between the bounds divided by the entry size. The section `other` holds one entry
// that reuses `@double`: `@count2` is 1, and `@lookup2` calls through it, so the two sections stay
// apart. `@lookup 40 5` is 25: `@square` of 5.
//
// The section `terms` holds entries of the shape a Firefly term has: a
// `struct<(i32, i64) -> (i1, i64), (ptr<i64>) -> i64, ptr<i64>>`, a function of two results under
// `extern("wasm")`, a function that takes a pointer under `extern("C")`, and the address it is
// given. The lowering converts the signatures of those functions (`i1` and `ptr<i64>` are carried
// in `i32`), and the function types in the data follow them. `@term i tag x` calls the first
// function of entry `i` on `tag` and `x`, and gives its two results, which `wasmtime` prints on two
// lines; `@read i` calls the second on the third. Entry 0 adds the tag to `x` and says whether the
// sum is not negative; entry 1 multiplies them and says whether the product is not zero. Entry 0
// reads its cell (41) plus one, entry 1 its cell (9) negated.

// TEN: {{^}}6{{$}}
// TWENTY: {{^}}10{{$}}
// THIRTY: {{^}}-5{{$}}
// FORTY: {{^}}25{{$}}
// MISS: {{^}}-1{{$}}
// COUNT: {{^}}4{{$}}
// COUNT2: {{^}}1{{$}}
// SECOND: {{^}}14{{$}}
// ADD: {{^}}1{{$}}
// ADD-NEXT: {{^}}8{{$}}
// ADD-NEG: {{^}}0{{$}}
// ADD-NEG-NEXT: {{^}}-5{{$}}
// MUL: {{^}}1{{$}}
// MUL-NEXT: {{^}}15{{$}}
// MUL-ZERO: {{^}}0{{$}}
// MUL-ZERO-NEXT: {{^}}0{{$}}
// READ-ADD: {{^}}42{{$}}
// READ-MUL: {{^}}-9{{$}}

builtin.module public @table {
    builtin.function public extern("wasm") @add_one(%x: i64) -> i64 {
        %one = arith.constant 1 : i64;
        %r = arith.add %x, %one;
        builtin.ret %r : (i64);
    };

    builtin.function public extern("wasm") @double(%x: i64) -> i64 {
        %r = arith.add %x, %x;
        builtin.ret %r : (i64);
    };

    builtin.function public extern("wasm") @negate(%x: i64) -> i64 {
        %zero = arith.constant 0 : i64;
        %r = arith.sub %zero, %x;
        builtin.ret %r : (i64);
    };

    builtin.function public extern("wasm") @square(%x: i64) -> i64 {
        %r = arith.mul %x, %x;
        builtin.ret %r : (i64);
    };

    builtin.global_variable private @entry_add_one : struct<i32, i32, (i64) -> i64> {
        %id = arith.constant 10 : i32;
        %arity = arith.constant 1 : i32;
        %f = builtin.function_ref @add_one : (i64) -> i64;
        %e = builtin.aggregate %id, %arity, %f : struct<i32, i32, (i64) -> i64>;
        builtin.yield %e;
    } attributes { section = "dispatch" };

    builtin.global_variable private @entry_double : struct<i32, i32, (i64) -> i64> {
        %id = arith.constant 20 : i32;
        %arity = arith.constant 1 : i32;
        %f = builtin.function_ref @double : (i64) -> i64;
        %e = builtin.aggregate %id, %arity, %f : struct<i32, i32, (i64) -> i64>;
        builtin.yield %e;
    } attributes { section = "dispatch" };

    // Not in the section: the layout places it before every section.
    builtin.global_variable private @calls : i32 {
        %zero = arith.constant 0 : i32;
        builtin.yield %zero;
    };

    builtin.global_variable private @entry_negate : struct<i32, i32, (i64) -> i64> {
        %id = arith.constant 30 : i32;
        %arity = arith.constant 1 : i32;
        %f = builtin.function_ref @negate : (i64) -> i64;
        %e = builtin.aggregate %id, %arity, %f : struct<i32, i32, (i64) -> i64>;
        builtin.yield %e;
    } attributes { section = "dispatch" };

    // The other table, of one entry, in a section of its own.
    builtin.global_variable private @other_double : struct<i32, i32, (i64) -> i64> {
        %id = arith.constant 7 : i32;
        %arity = arith.constant 1 : i32;
        %f = builtin.function_ref @double : (i64) -> i64;
        %e = builtin.aggregate %id, %arity, %f : struct<i32, i32, (i64) -> i64>;
        builtin.yield %e;
    } attributes { section = "other" };

    builtin.function public extern("C") @count() -> i32 {
        %s = builtin.global_symbol @start : ptr<struct<i32, i32, (i64) -> i64>>;
        %e = builtin.global_symbol @stop : ptr<struct<i32, i32, (i64) -> i64>>;
        %si = mem.ptrtoint %s;
        %ei = mem.ptrtoint %e;
        %bytes = arith.sub %ei, %si;
        %size = mem.sizeof struct<i32, i32, (i64) -> i64>;
        %n = arith.udiv %bytes, %size;
        %r = arith.zext_or_trunc %n <{ ty = i32 }>;
        builtin.ret %r : (i32);
    } attributes { wasm.export_name = "count" };

    builtin.global_variable private @entry_square : struct<i32, i32, (i64) -> i64> {
        %id = arith.constant 40 : i32;
        %arity = arith.constant 1 : i32;
        %f = builtin.function_ref @square : (i64) -> i64;
        %e = builtin.aggregate %id, %arity, %f : struct<i32, i32, (i64) -> i64>;
        builtin.yield %e;
    } attributes { section = "dispatch" };

    // The bounds of the sections, which the layout defines: addresses with no bytes.
    builtin.global_variable public @start : struct<i32, i32, (i64) -> i64> attributes { link_name = "__start_dispatch" };
    builtin.global_variable public @stop : struct<i32, i32, (i64) -> i64> attributes { link_name = "__stop_dispatch" };
    builtin.global_variable public @start2 : struct<i32, i32, (i64) -> i64> attributes { link_name = "__start_other" };
    builtin.global_variable public @stop2 : struct<i32, i32, (i64) -> i64> attributes { link_name = "__stop_other" };

    builtin.function public extern("C") @lookup(%id: i32, %x: i64) -> i64 {
        %s = builtin.global_symbol @start : ptr<struct<i32, i32, (i64) -> i64>>;
        %e = builtin.global_symbol @stop : ptr<struct<i32, i32, (i64) -> i64>>;
        %si = mem.ptrtoint %s;
        %ei = mem.ptrtoint %e;
        cf.br ^head(%si : isize);
    ^head(%at: isize):
        %done = arith.cmpi uge %at, %ei;
        cf.cond_br %done ^miss, ^body : (i1);
    ^body:
        %entry = mem.inttoptr %at : ptr<struct<i32, i32, (i64) -> i64>>;
        %idp = mem.gep %entry, [0];
        %entry_id = mem.load %idp;
        %found = arith.cmpi eq %entry_id, %id;
        cf.cond_br %found ^call, ^next : (i1);
    ^next:
        %size = mem.sizeof struct<i32, i32, (i64) -> i64>;
        %at2 = arith.add %at, %size;
        cf.br ^head(%at2 : isize);
    ^call:
        %fp = mem.gep %entry, [2];
        %f = mem.load %fp;
        %r = builtin.call_indirect %f(%x) : extern("wasm") (i64) -> i64;
        builtin.ret %r : (i64);
    ^miss:
        %minus_one = arith.constant -1 : i64;
        builtin.ret %minus_one : (i64);
    } attributes { wasm.export_name = "lookup" };

    builtin.function public extern("C") @count2() -> i32 {
        %s = builtin.global_symbol @start2 : ptr<struct<i32, i32, (i64) -> i64>>;
        %e = builtin.global_symbol @stop2 : ptr<struct<i32, i32, (i64) -> i64>>;
        %si = mem.ptrtoint %s;
        %ei = mem.ptrtoint %e;
        %bytes = arith.sub %ei, %si;
        %size = mem.sizeof struct<i32, i32, (i64) -> i64>;
        %n = arith.udiv %bytes, %size;
        %r = arith.zext_or_trunc %n <{ ty = i32 }>;
        builtin.ret %r : (i32);
    } attributes { wasm.export_name = "count2" };

    builtin.function public extern("C") @lookup2(%x: i64) -> i64 {
        %s = builtin.global_symbol @start2 : ptr<struct<i32, i32, (i64) -> i64>>;
        %fp = mem.gep %s, [2];
        %f = mem.load %fp;
        %r = builtin.call_indirect %f(%x) : extern("wasm") (i64) -> i64;
        builtin.ret %r : (i64);
    } attributes { wasm.export_name = "lookup2" };

    // The third section: terms, whose functions' signatures the lowering converts.
    builtin.function public extern("wasm") @add_tag(%tag: i32, %x: i64) -> (i1, i64) {
        %t = arith.sext %tag <{ ty = i64 }>;
        %r = arith.add %x, %t;
        %zero = arith.constant 0 : i64;
        %ok = arith.cmpi sge %r, %zero;
        builtin.ret %ok, %r : (i1, i64);
    };

    builtin.function public extern("wasm") @mul_tag(%tag: i32, %x: i64) -> (i1, i64) {
        %t = arith.sext %tag <{ ty = i64 }>;
        %r = arith.mul %x, %t;
        %zero = arith.constant 0 : i64;
        %ok = arith.cmpi ne %r, %zero;
        builtin.ret %ok, %r : (i1, i64);
    };

    builtin.function public extern("C") @plus_one(%p: ptr<i64>) -> i64 {
        %v = mem.load %p;
        %one = arith.constant 1 : i64;
        %r = arith.add %v, %one;
        builtin.ret %r : (i64);
    };

    builtin.function public extern("C") @negated(%p: ptr<i64>) -> i64 {
        %v = mem.load %p;
        %zero = arith.constant 0 : i64;
        %r = arith.sub %zero, %v;
        builtin.ret %r : (i64);
    };

    builtin.global_variable private @cell_add : i64 {
        %v = arith.constant 41 : i64;
        builtin.yield %v;
    };

    builtin.global_variable private @cell_mul : i64 {
        %v = arith.constant 9 : i64;
        builtin.yield %v;
    };

    builtin.global_variable private @term_add : struct<(i32, i64) -> (i1, i64), (ptr<i64>) -> i64, ptr<i64>> {
        %f = builtin.function_ref @add_tag : (i32, i64) -> (i1, i64);
        %g = builtin.function_ref @plus_one : (ptr<i64>) -> i64;
        %c = builtin.global_symbol @cell_add : ptr<i64>;
        %e = builtin.aggregate %f, %g, %c : struct<(i32, i64) -> (i1, i64), (ptr<i64>) -> i64, ptr<i64>>;
        builtin.yield %e;
    } attributes { section = "terms" };

    builtin.global_variable private @term_mul : struct<(i32, i64) -> (i1, i64), (ptr<i64>) -> i64, ptr<i64>> {
        %f = builtin.function_ref @mul_tag : (i32, i64) -> (i1, i64);
        %g = builtin.function_ref @negated : (ptr<i64>) -> i64;
        %c = builtin.global_symbol @cell_mul : ptr<i64>;
        %e = builtin.aggregate %f, %g, %c : struct<(i32, i64) -> (i1, i64), (ptr<i64>) -> i64, ptr<i64>>;
        builtin.yield %e;
    } attributes { section = "terms" };

    builtin.global_variable public @start3 : struct<(i32, i64) -> (i1, i64), (ptr<i64>) -> i64, ptr<i64>> attributes { link_name = "__start_terms" };

    builtin.function public extern("C") @term(%i: isize, %tag: i32, %x: i64) -> (i1, i64) {
        %s = builtin.global_symbol @start3 : ptr<struct<(i32, i64) -> (i1, i64), (ptr<i64>) -> i64, ptr<i64>>>;
        %entry = mem.gep %s, %i;
        %fp = mem.gep %entry, [0];
        %f = mem.load %fp;
        %ok, %r = builtin.call_indirect %f(%tag, %x) : extern("wasm") (i32, i64) -> (i1, i64);
        builtin.ret %ok, %r : (i1, i64);
    } attributes { wasm.export_name = "term" };

    builtin.function public extern("C") @read(%i: isize) -> i64 {
        %s = builtin.global_symbol @start3 : ptr<struct<(i32, i64) -> (i1, i64), (ptr<i64>) -> i64, ptr<i64>>>;
        %entry = mem.gep %s, %i;
        %gp = mem.gep %entry, [1];
        %g = mem.load %gp;
        %cp = mem.gep %entry, [2];
        %c = mem.load %cp;
        %r = builtin.call_indirect %g(%c) : extern("C") (ptr<i64>) -> i64;
        builtin.ret %r : (i64);
    } attributes { wasm.export_name = "read" };
};
