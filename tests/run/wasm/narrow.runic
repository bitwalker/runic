// RUN: runic-opt --target wasm32-unknown-unknown %s -o %t.wasm
// RUN: wasmtime run --invoke narrow %t.wasm 200 100 5 2>/dev/null | filecheck %s --check-prefix=CARRY
// RUN: wasmtime run --invoke narrow %t.wasm 100 50 65000 2>/dev/null | filecheck %s --check-prefix=NEG
// RUN: wasmtime run --invoke narrow %t.wasm 200 100 65000 2>/dev/null | filecheck %s --check-prefix=WRAP16
// RUN: wasmtime run --invoke narrow_c %t.wasm -56 100 -536 2>/dev/null | filecheck %s --check-prefix=WRAP16
// RUN: wasmtime run --invoke widen %t.wasm 200 2>/dev/null | filecheck %s --check-prefix=WIDEN
// RUN: wasmtime run --invoke widen %t.wasm -56 2>/dev/null | filecheck %s --check-prefix=WIDEN
// RUN: wasmtime run --invoke bits %t.wasm 1 1 2>/dev/null | filecheck %s --check-prefix=BITS11
// RUN: wasmtime run --invoke bits %t.wasm 1 0 2>/dev/null | filecheck %s --check-prefix=BITS10
// RUN: wasmtime run --invoke calls %t.wasm 200 300 1 2>/dev/null | filecheck %s --check-prefix=CALLS1
// RUN: wasmtime run --invoke calls %t.wasm 200 100 0 2>/dev/null | filecheck %s --check-prefix=CALLS0
// RUN: runic-opt --target wasm32-unknown-unknown %s -p 'canonicalizer,cse,sccp,canonicalizer,dce' -o %t.opt.wasm
// RUN: wasmtime run --invoke narrow %t.opt.wasm 200 100 5 2>/dev/null | filecheck %s --check-prefix=CARRY
// RUN: wasmtime run --invoke narrow %t.opt.wasm 100 50 65000 2>/dev/null | filecheck %s --check-prefix=NEG
// RUN: wasmtime run --invoke narrow %t.opt.wasm 200 100 65000 2>/dev/null | filecheck %s --check-prefix=WRAP16
// RUN: wasmtime run --invoke narrow_c %t.opt.wasm -56 100 -536 2>/dev/null | filecheck %s --check-prefix=WRAP16
// RUN: wasmtime run --invoke widen %t.opt.wasm 200 2>/dev/null | filecheck %s --check-prefix=WIDEN
// RUN: wasmtime run --invoke widen %t.opt.wasm -56 2>/dev/null | filecheck %s --check-prefix=WIDEN
// RUN: wasmtime run --invoke bits %t.opt.wasm 1 1 2>/dev/null | filecheck %s --check-prefix=BITS11
// RUN: wasmtime run --invoke bits %t.opt.wasm 1 0 2>/dev/null | filecheck %s --check-prefix=BITS10
// RUN: wasmtime run --invoke calls %t.opt.wasm 200 300 1 2>/dev/null | filecheck %s --check-prefix=CALLS1
// RUN: wasmtime run --invoke calls %t.opt.wasm 200 100 0 2>/dev/null | filecheck %s --check-prefix=CALLS0

// Narrow integers, each carried zero-extended in an `i32`, under both calling conventions.
//
// `@narrow` (`extern("wasm")`, 6c's program) adds two `i8`s, takes the carry (`ult` of the sum
// and an operand) and the sign of the sum (`slt` 0), and selects the `i16` `h + 1000` when there
// is a carry: 200 + 100 is 44 as an `i8`, with a carry; 100 + 50 is 150, negative as an `i8`; and
// 65000 + 1000 wraps to 464 as an `i16`. `@narrow_c` is the same function under `extern("C")`,
// which masks its arguments at the entry: -56 is the `i8` 200 and -536 the `i16` 65000.
// `@widen` sign- and zero-extends an `i8` to `i32`. `@bits` adds (1 + 1 wraps to 0), ands and
// selects `i1`s. `@calls` calls a callee of each convention: `@c_plain` compares its zero-extended
// `i8` with its `i16`, `@c_marked` takes a sign-extended `i8` and a zero-extended `i1` and returns
// the negation of the `i8` when the flag is set, as a zero-extended `i8` (-200 is 56), and
// `@w_plain` returns the `i8` sign-extended to `i16` when the flag is set (200 is 65480).

// CARRY: {{^}}1005{{$}}
// CARRY-NEXT: {{^}}1{{$}}
// CARRY-NEXT: {{^}}0{{$}}
// NEG: {{^}}65000{{$}}
// NEG-NEXT: {{^}}0{{$}}
// NEG-NEXT: {{^}}1{{$}}
// WRAP16: {{^}}464{{$}}
// WRAP16-NEXT: {{^}}1{{$}}
// WRAP16-NEXT: {{^}}0{{$}}
// WIDEN: {{^}}-56{{$}}
// WIDEN-NEXT: {{^}}200{{$}}
// BITS11: {{^}}0{{$}}
// BITS11-NEXT: {{^}}1{{$}}
// BITS11-NEXT: {{^}}1{{$}}
// BITS10: {{^}}1{{$}}
// BITS10-NEXT: {{^}}0{{$}}
// BITS10-NEXT: {{^}}1{{$}}
// CALLS1: {{^}}1{{$}}
// CALLS1-NEXT: {{^}}56{{$}}
// CALLS1-NEXT: {{^}}65480{{$}}
// CALLS0: {{^}}0{{$}}
// CALLS0-NEXT: {{^}}200{{$}}
// CALLS0-NEXT: {{^}}200{{$}}

builtin.module public @narrow {
    builtin.function public extern("wasm") @narrow(%a: i8, %b: i8, %h: i16) -> (i16, i1, i1) {
        %s = arith.add %a, %b;
        %carry = arith.cmpi ult %s, %a;
        %zero = arith.constant 0 : i8;
        %again = arith.add %a, %b;
        %neg = arith.cmpi slt %again, %zero;
        %k = arith.constant 1000 : i16;
        %hk = arith.add %h, %k;
        %r = cf.select %carry, %hk, %h;
        builtin.ret %r, %carry, %neg : (i16, i1, i1);
    } attributes { wasm.export_name = "narrow" };

    builtin.function public extern("C") @narrow_c(%a: i8, %b: i8, %h: i16) -> (i16, i1, i1) {
        %s = arith.add %a, %b;
        %carry = arith.cmpi ult %s, %a;
        %zero = arith.constant 0 : i8;
        %neg = arith.cmpi slt %s, %zero;
        %k = arith.constant 1000 : i16;
        %hk = arith.add %h, %k;
        %r = cf.select %carry, %hk, %h;
        builtin.ret %r, %carry, %neg : (i16, i1, i1);
    } attributes { wasm.export_name = "narrow_c" };

    builtin.function public extern("C") @widen(%a: i8) -> (i32, i32) {
        %s = arith.sext %a <{ ty = i32 }>;
        %z = arith.zext %a <{ ty = i32 }>;
        builtin.ret %s, %z : (i32, i32);
    } attributes { wasm.export_name = "widen" };

    builtin.function public extern("C") @bits(%x: i1, %y: i1) -> (i1, i1, i1) {
        %sum = arith.add %x, %y;
        %both = arith.band %x, %y;
        %not_y = arith.bnot %y;
        %pick = cf.select %x, %y, %not_y;
        %either = arith.bor %pick, %sum;
        builtin.ret %sum, %both, %either : (i1, i1, i1);
    } attributes { wasm.export_name = "bits" };

    builtin.function public extern("C") @c_plain(%a: i8, %h: i16) -> i1 {
        %wide = arith.zext %a <{ ty = i16 }>;
        %r = arith.cmpi ult %wide, %h;
        builtin.ret %r : (i1);
    };

    builtin.function public extern("C") @c_marked(%a: i8 { extend = #builtin.sext }, %f: i1 { extend = #builtin.zext }) -> (i8 { extend = #builtin.zext }) {
        %n = arith.neg %a;
        %r = cf.select %f, %n, %a;
        builtin.ret %r : (i8);
    };

    builtin.function public extern("wasm") @w_plain(%a: i8, %f: i1) -> i16 {
        %s = arith.sext %a <{ ty = i16 }>;
        %z = arith.zext %a <{ ty = i16 }>;
        %r = cf.select %f, %s, %z;
        builtin.ret %r : (i16);
    };

    builtin.function public extern("C") @calls(%a: i8, %h: i16, %f: i1) -> (i1, i8, i16) {
        %p = builtin.call @c_plain(%a, %h) : extern("C") (i8, i16) -> i1;
        %m = builtin.call @c_marked(%a, %f) : extern("C") (i8 { extend = #builtin.sext }, i1 { extend = #builtin.zext }) -> (i8 { extend = #builtin.zext });
        %w = builtin.call @w_plain(%a, %f) : extern("wasm") (i8, i1) -> i16;
        builtin.ret %p, %m, %w : (i1, i8, i16);
    } attributes { wasm.export_name = "calls" };
};
