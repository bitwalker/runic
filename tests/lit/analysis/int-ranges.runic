// RUN: runic-opt %s -p test-print-int-ranges --verify-diagnostics | filecheck %s

// The integer range analysis from text. `test-print-int-ranges` emits one hint per integer
// result, at the operation; the hints are checked in place and the IR is printed unchanged.
// CHECK-LABEL: @f(
builtin.module public @m {
    builtin.function public extern("C") @f(%a: i32, %c: i1) -> i32 {
        %x = arith.constant 10 : i32; // expected-hint {{range of result 0: u[10, 10] s[10, 10] width 32}}
        %y = arith.constant 20 : i32; // expected-hint {{u[20, 20]}}
        // A sum of constants is a constant.
        // expected-hint@+1 {{range of result 0: u[30, 30] s[30, 30] width 32}}
        %s = arith.add %x, %y;
        // An argument is not known.
        // expected-hint@below {{range of result 0: u[0, 4294967295] s[-2147483648, 2147483647] width 32}}
        %t = arith.add %a, %x;
        %lt = arith.cmpi ult %a, %x; // expected-hint-re {{u\[0, 1\] s\[-1, 0\] width 1$}}
        // CHECK: builtin.ret {{%[0-9]+}} : (i32);
        builtin.ret %t : (i32);
    };

    // Each other operation that states a range: `test.check_range` refines its operand's range by
    // the one it checks; a cast between integers of one width keeps the range and any other cast
    // gives its type's; a comparison that the ranges decide is a constant. An operation that
    // states no range (`arith.mul`) gets its type's. A block argument is the join of what its
    // predecessors pass, which the sum then reads.
    // CHECK-LABEL: @g(
    // CHECK: builtin.ret {{%[0-9]+}} : (i8);
    builtin.function public extern("C") @g(%a: i8, %c: i1) -> i8 {
        // expected-hint@+1 {{range of result 0: u[1, 10] s[1, 10] width 8}}
        %checked = test.check_range %a <{ umin = #builtin.int<1 : i8>, umax = #builtin.int<10 : i8> }>;
        %one = arith.constant 1 : i8; // expected-hint {{range of result 0: u[1, 1] s[1, 1] width 8}}
        // expected-hint@+1 {{range of result 0: u[2, 11] s[2, 11] width 8}}
        %sum = arith.add %checked, %one <{ overflow = #builtin.overflow<checked unsigned> }>;
        %lt = arith.cmpi ult %checked, %one; // expected-hint {{range of result 0: u[0, 0] s[0, 0] width 1}}
        // expected-hint@+1 {{range of result 0: u[1, 10] s[1, 10] width 8}}
        %same = builtin.unrealized_conversion_cast %checked : i8 to i8;
        // expected-hint@+1 {{range of result 0: u[0, 4294967295] s[-2147483648, 2147483647] width 32}}
        %wide = builtin.unrealized_conversion_cast %checked : i8 to i32;
        %m = arith.mul %checked, %one; // expected-hint {{range of result 0: u[0, 255] s[-128, 127] width 8}}
        %two = arith.constant 2 : i8; // expected-hint {{range of result 0: u[2, 2] s[2, 2] width 8}}
        cf.cond_br %c ^join(%one : i8), ^join(%two : i8) : (i1);
    ^join(%j: i8):
        %k = arith.add %j, %j; // expected-hint {{range of result 0: u[2, 4] s[2, 4] width 8}}
        builtin.ret %k : (i8);
    };
};
