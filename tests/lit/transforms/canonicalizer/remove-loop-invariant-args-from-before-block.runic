// RUN: runic-opt %s -p 'builtin.module(builtin.function(canonicalizer{enable-patterns=remove-loop-invariant-args-from-before-block}))' | filecheck %s
// RUN: runic-opt %s -p 'builtin.module(builtin.function(canonicalizer{enable-patterns=remove-loop-invariant-args-from-before-block}))' | runic-opt - --verify-roundtrip | filecheck %s

// The `remove-loop-invariant-args-from-before-block` canonicalization of `scf.while`, with the
// canonicalizer restricted to that pattern (the greedy driver still folds, erases trivially dead
// operations and simplifies regions). The second RUN line reads the rewritten IR back.
//
// A before-block argument is loop invariant when the value fed back to it over the back edge is
// always its initial value, i.e. when the i-th `scf.yield` operand
//   1. is the i-th `scf.while` operand itself, or
//   2. is the k-th after-block argument and the k-th `scf.condition` forwarded operand is either
//      the i-th before-block argument or the i-th `scf.while` operand.
// Such a column is dropped from the loop (`scf.while` operand, before-block argument, `scf.yield`
// operand) and the uses of the before-block argument are replaced with the initial value. The
// results of the loop and the after block keep their arity, and the `scf.condition` operands keep
// their count and positions (one that was the removed argument becomes the initial value).
builtin.module private @remove_loop_invariant_args {
    // Case 1: the yield operand for column 0 is the loop operand `%a` itself.
    // CHECK-LABEL: @yield_init(
    // CHECK-SAME: [[A:%[0-9]+]]: i32, [[B:%[0-9]+]]: i32)
    // CHECK-NEXT: [[TEN:%[0-9]+]] = arith.constant 10 : i32;
    // CHECK-NEXT: [[R0:%[0-9]+]], [[R1:%[0-9]+]] = scf.while [[B]] before {
    // CHECK-NEXT: ^{{block[0-9]+}}([[Y:%[0-9]+]]: i32):
    // CHECK-NEXT: [[C:%[0-9]+]] = arith.cmpi ult [[Y]], [[TEN]];
    // CHECK-NEXT: scf.condition [[C]], [[A]], [[Y]] : (i1, i32, i32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^{{block[0-9]+}}([[P:%[0-9]+]]: i32, [[Q:%[0-9]+]]: i32):
    // CHECK-NEXT: [[S:%[0-9]+]] = arith.add [[Q]], [[P]]
    // CHECK-NEXT: scf.yield [[S]] : (i32);
    // CHECK-NEXT: } : (i32) -> (i32, i32);
    // CHECK-NEXT: arith.add [[R0]], [[R1]]
    builtin.function public extern("C") @yield_init(%a: i32, %b: i32) -> i32 {
        %c10 = arith.constant 10 : i32;
        %res0, %res1 = scf.while %a, %b before {
        ^before(%iter0: i32, %iter1: i32):
            %cond = arith.cmpi ult %iter1, %c10;
            scf.condition %cond, %iter0, %iter1 : (i1, i32, i32);
        } after {
        ^after(%fwd0: i32, %fwd1: i32):
            %sum = arith.add %fwd1, %fwd0 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
            scf.yield %a, %sum : (i32, i32);
        } : (i32, i32) -> (i32, i32);
        %sum2 = arith.add %res0, %res1 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
        builtin.ret %sum2 : (i32);
    };

    // Case 2: the yield operand for column 0 is after-block argument 0, and `scf.condition`
    // forwards before-block argument 0 in position 0, so the column is passed around unchanged.
    // CHECK-LABEL: @yield_forwarded_before_arg(
    // CHECK-SAME: [[A:%[0-9]+]]: i32, [[B:%[0-9]+]]: i32)
    // CHECK-NEXT: [[TEN:%[0-9]+]] = arith.constant 10 : i32;
    // CHECK-NEXT: [[R0:%[0-9]+]], [[R1:%[0-9]+]] = scf.while [[B]] before {
    // CHECK-NEXT: ^{{block[0-9]+}}([[Y:%[0-9]+]]: i32):
    // CHECK-NEXT: [[C:%[0-9]+]] = arith.cmpi ult [[Y]], [[TEN]];
    // CHECK-NEXT: scf.condition [[C]], [[A]], [[Y]] : (i1, i32, i32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^{{block[0-9]+}}([[P:%[0-9]+]]: i32, [[Q:%[0-9]+]]: i32):
    // CHECK-NEXT: [[S:%[0-9]+]] = arith.add [[Q]], [[P]]
    // CHECK-NEXT: scf.yield [[S]] : (i32);
    // CHECK-NEXT: } : (i32) -> (i32, i32);
    // CHECK-NEXT: arith.add [[R0]], [[R1]]
    builtin.function public extern("C") @yield_forwarded_before_arg(%a: i32, %b: i32) -> i32 {
        %c10 = arith.constant 10 : i32;
        %res0, %res1 = scf.while %a, %b before {
        ^before(%iter0: i32, %iter1: i32):
            %cond = arith.cmpi ult %iter1, %c10;
            scf.condition %cond, %iter0, %iter1 : (i1, i32, i32);
        } after {
        ^after(%fwd0: i32, %fwd1: i32):
            %sum = arith.add %fwd1, %fwd0 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
            scf.yield %fwd0, %sum : (i32, i32);
        } : (i32, i32) -> (i32, i32);
        %sum2 = arith.add %res0, %res1 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
        builtin.ret %sum2 : (i32);
    };

    // Case 2, second form: `scf.condition` forwards the loop operand `%a` itself (not the
    // before-block argument) in position 0, and the yield feeds after-block argument 0 back.
    // The before-block argument is used in the before body; that use becomes `%a`.
    // CHECK-LABEL: @yield_forwarded_init(
    // CHECK-SAME: [[A:%[0-9]+]]: i32, [[B:%[0-9]+]]: i32)
    // CHECK-NEXT: [[TEN:%[0-9]+]] = arith.constant 10 : i32;
    // CHECK-NEXT: [[ONE:%[0-9]+]] = arith.constant 1 : i32;
    // CHECK-NEXT: [[R0:%[0-9]+]], [[R1:%[0-9]+]] = scf.while [[B]] before {
    // CHECK-NEXT: ^{{block[0-9]+}}([[Y:%[0-9]+]]: i32):
    // CHECK-NEXT: [[S:%[0-9]+]] = arith.add [[A]], [[Y]]
    // CHECK-NEXT: [[C:%[0-9]+]] = arith.cmpi ult [[S]], [[TEN]];
    // CHECK-NEXT: scf.condition [[C]], [[A]], [[S]] : (i1, i32, i32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^{{block[0-9]+}}({{%[0-9]+}}: i32, [[Q:%[0-9]+]]: i32):
    // CHECK-NEXT: [[N:%[0-9]+]] = arith.add [[Q]], [[ONE]]
    // CHECK-NEXT: scf.yield [[N]] : (i32);
    // CHECK-NEXT: } : (i32) -> (i32, i32);
    // CHECK-NEXT: arith.add [[R0]], [[R1]]
    builtin.function public extern("C") @yield_forwarded_init(%a: i32, %b: i32) -> i32 {
        %c10 = arith.constant 10 : i32;
        %c1 = arith.constant 1 : i32;
        %res0, %res1 = scf.while %a, %b before {
        ^before(%iter0: i32, %iter1: i32):
            %sum = arith.add %iter0, %iter1 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
            %cond = arith.cmpi ult %sum, %c10;
            scf.condition %cond, %a, %sum : (i1, i32, i32);
        } after {
        ^after(%fwd0: i32, %fwd1: i32):
            %sum2 = arith.add %fwd1, %c1 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
            scf.yield %fwd0, %sum2 : (i32, i32);
        } : (i32, i32) -> (i32, i32);
        %sum3 = arith.add %res0, %res1 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
        builtin.ret %sum3 : (i32);
    };

    // Columns 0 (case 1) and 2 (case 2) are invariant, columns 1 and 3 are not: the loop keeps
    // operands `%b, %d`, the surviving before-block arguments keep their relative order, and all
    // four results stay in place.
    // CHECK-LABEL: @mixed_positions(
    // CHECK-SAME: [[A:%[0-9]+]]: i32, [[B:%[0-9]+]]: i32, [[C:%[0-9]+]]: i32, [[D:%[0-9]+]]: i32)
    // CHECK-NEXT: [[TEN:%[0-9]+]] = arith.constant 10 : i32;
    // CHECK-NEXT: [[R0:%[0-9]+]], [[R1:%[0-9]+]], [[R2:%[0-9]+]], [[R3:%[0-9]+]] = scf.while [[B]], [[D]] before {
    // CHECK-NEXT: ^{{block[0-9]+}}([[X:%[0-9]+]]: i32, [[Y:%[0-9]+]]: i32):
    // CHECK-NEXT: [[S0:%[0-9]+]] = arith.add [[A]], [[C]]
    // CHECK-NEXT: [[S1:%[0-9]+]] = arith.add [[S0]], [[X]]
    // CHECK-NEXT: [[CND:%[0-9]+]] = arith.cmpi ult [[S1]], [[TEN]];
    // CHECK-NEXT: scf.condition [[CND]], [[A]], [[X]], [[C]], [[Y]] : (i1, i32, i32, i32, i32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^{{block[0-9]+}}([[P0:%[0-9]+]]: i32, [[P1:%[0-9]+]]: i32, [[P2:%[0-9]+]]: i32, [[P3:%[0-9]+]]: i32):
    // CHECK-NEXT: [[N1:%[0-9]+]] = arith.add [[P1]], [[P0]]
    // CHECK-NEXT: [[N3:%[0-9]+]] = arith.add [[P3]], [[P2]]
    // CHECK-NEXT: scf.yield [[N1]], [[N3]] : (i32, i32);
    // CHECK-NEXT: } : (i32, i32) -> (i32, i32, i32, i32);
    // CHECK-NEXT: [[T0:%[0-9]+]] = arith.add [[R0]], [[R1]]
    // CHECK-NEXT: [[T1:%[0-9]+]] = arith.add [[T0]], [[R2]]
    // CHECK-NEXT: arith.add [[T1]], [[R3]]
    builtin.function public extern("C") @mixed_positions(%a: i32, %b: i32, %c: i32, %d: i32) -> i32 {
        %c10 = arith.constant 10 : i32;
        %res0, %res1, %res2, %res3 = scf.while %a, %b, %c, %d before {
        ^before(%iter0: i32, %iter1: i32, %iter2: i32, %iter3: i32):
            %sum = arith.add %iter0, %iter2 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
            %sum2 = arith.add %sum, %iter1 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
            %cond = arith.cmpi ult %sum2, %c10;
            scf.condition %cond, %iter0, %iter1, %iter2, %iter3 : (i1, i32, i32, i32, i32);
        } after {
        ^after(%fwd0: i32, %fwd1: i32, %fwd2: i32, %fwd3: i32):
            %sum3 = arith.add %fwd1, %fwd0 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
            %sum4 = arith.add %fwd3, %fwd2 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
            scf.yield %a, %sum3, %fwd2, %sum4 : (i32, i32, i32, i32);
        } : (i32, i32, i32, i32) -> (i32, i32, i32, i32);
        %sum5 = arith.add %res0, %res1 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
        %sum6 = arith.add %sum5, %res2 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
        %sum7 = arith.add %sum6, %res3 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
        builtin.ret %sum7 : (i32);
    };

    // Every column is invariant (column 0 by case 2, column 1 by case 1): the loop is left with
    // no operands, an argument-less before block and an empty yield, while its results survive.
    // CHECK-LABEL: @all_invariant(
    // CHECK-SAME: [[A:%[0-9]+]]: i32, [[B:%[0-9]+]]: i32)
    // CHECK-NEXT: [[TEN:%[0-9]+]] = arith.constant 10 : i32;
    // CHECK-NEXT: [[R0:%[0-9]+]], [[R1:%[0-9]+]] = scf.while before {
    // CHECK-NEXT: [[S:%[0-9]+]] = arith.add [[A]], [[B]]
    // CHECK-NEXT: [[C:%[0-9]+]] = arith.cmpi ult [[S]], [[TEN]];
    // CHECK-NEXT: scf.condition [[C]], [[A]], [[S]] : (i1, i32, i32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^{{block[0-9]+}}({{%[0-9]+}}: i32, {{%[0-9]+}}: i32):
    // CHECK-NEXT: scf.yield : ();
    // CHECK-NEXT: } : () -> (i32, i32);
    // CHECK-NEXT: arith.add [[R0]], [[R1]]
    builtin.function public extern("C") @all_invariant(%a: i32, %b: i32) -> i32 {
        %c10 = arith.constant 10 : i32;
        %res0, %res1 = scf.while %a, %b before {
        ^before(%iter0: i32, %iter1: i32):
            %sum = arith.add %iter0, %iter1 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
            %cond = arith.cmpi ult %sum, %c10;
            scf.condition %cond, %iter0, %sum : (i1, i32, i32);
        } after {
        ^after(%fwd0: i32, %fwd1: i32):
            scf.yield %fwd0, %b : (i32, i32);
        } : (i32, i32) -> (i32, i32);
        %sum2 = arith.add %res0, %res1 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
        builtin.ret %sum2 : (i32);
    };

    // The invariant before-block argument is used inside a nested region of the before body;
    // those uses are replaced too.
    // CHECK-LABEL: @nested_use(
    // CHECK-SAME: [[A:%[0-9]+]]: i32, [[B:%[0-9]+]]: i32)
    // CHECK-NEXT: [[TEN:%[0-9]+]] = arith.constant 10 : i32;
    // CHECK-NEXT: [[ONE:%[0-9]+]] = arith.constant 1 : i32;
    // CHECK-NEXT: [[R0:%[0-9]+]], [[R1:%[0-9]+]] = scf.while [[B]] before {
    // CHECK-NEXT: ^{{block[0-9]+}}([[Y:%[0-9]+]]: i32):
    // CHECK-NEXT: [[C:%[0-9]+]] = arith.cmpi ult [[Y]], [[TEN]];
    // CHECK-NEXT: [[V:%[0-9]+]] = scf.if [[C]] then {
    // CHECK-NEXT: [[S:%[0-9]+]] = arith.add [[A]], [[ONE]]
    // CHECK-NEXT: scf.yield [[S]] : (i32);
    // CHECK-NEXT: } else {
    // CHECK-NEXT: scf.yield [[A]] : (i32);
    // CHECK-NEXT: } : (i1) -> (i32);
    // CHECK-NEXT: scf.condition [[C]], [[V]], [[Y]] : (i1, i32, i32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^{{block[0-9]+}}([[P:%[0-9]+]]: i32, [[Q:%[0-9]+]]: i32):
    // CHECK-NEXT: [[N:%[0-9]+]] = arith.add [[Q]], [[P]]
    // CHECK-NEXT: scf.yield [[N]] : (i32);
    // CHECK-NEXT: } : (i32) -> (i32, i32);
    // CHECK-NEXT: arith.add [[R0]], [[R1]]
    builtin.function public extern("C") @nested_use(%a: i32, %b: i32) -> i32 {
        %c10 = arith.constant 10 : i32;
        %c1 = arith.constant 1 : i32;
        %res0, %res1 = scf.while %a, %b before {
        ^before(%iter0: i32, %iter1: i32):
            %cond = arith.cmpi ult %iter1, %c10;
            %chosen = scf.if %cond then {
                %sum = arith.add %iter0, %c1 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
                scf.yield %sum : (i32);
            } else {
                scf.yield %iter0 : (i32);
            } : (i1) -> (i32);
            scf.condition %cond, %chosen, %iter1 : (i1, i32, i32);
        } after {
        ^after(%fwd0: i32, %fwd1: i32):
            %sum2 = arith.add %fwd1, %fwd0 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
            scf.yield %a, %sum2 : (i32, i32);
        } : (i32, i32) -> (i32, i32);
        %sum3 = arith.add %res0, %res1 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
        builtin.ret %sum3 : (i32);
    };

    // Negative: both yield operands are computed in the after body, nothing is invariant and
    // the loop is left untouched.
    // CHECK-LABEL: @no_invariant(
    // CHECK-SAME: [[A:%[0-9]+]]: i32, [[B:%[0-9]+]]: i32)
    // CHECK-NEXT: [[TEN:%[0-9]+]] = arith.constant 10 : i32;
    // CHECK-NEXT: [[R0:%[0-9]+]], [[R1:%[0-9]+]] = scf.while [[A]], [[B]] before {
    // CHECK-NEXT: ^{{block[0-9]+}}([[X:%[0-9]+]]: i32, [[Y:%[0-9]+]]: i32):
    // CHECK-NEXT: [[C:%[0-9]+]] = arith.cmpi ult [[Y]], [[TEN]];
    // CHECK-NEXT: scf.condition [[C]], [[X]], [[Y]] : (i1, i32, i32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^{{block[0-9]+}}([[P:%[0-9]+]]: i32, [[Q:%[0-9]+]]: i32):
    // CHECK-NEXT: [[S:%[0-9]+]] = arith.add [[Q]], [[P]]
    // CHECK-NEXT: scf.yield [[S]], [[S]] : (i32, i32);
    // CHECK-NEXT: } : (i32, i32) -> (i32, i32);
    builtin.function public extern("C") @no_invariant(%a: i32, %b: i32) -> i32 {
        %c10 = arith.constant 10 : i32;
        %res0, %res1 = scf.while %a, %b before {
        ^before(%iter0: i32, %iter1: i32):
            %cond = arith.cmpi ult %iter1, %c10;
            scf.condition %cond, %iter0, %iter1 : (i1, i32, i32);
        } after {
        ^after(%fwd0: i32, %fwd1: i32):
            %sum = arith.add %fwd1, %fwd0 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
            scf.yield %sum, %sum : (i32, i32);
        } : (i32, i32) -> (i32, i32);
        %sum2 = arith.add %res0, %res1 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
        builtin.ret %sum2 : (i32);
    };

    // Negative: the yield operand for column 0 is the function argument `%a`, a block argument
    // of the entry block with index 0. Only after-block arguments are mirrored by the
    // `scf.condition` operands, so the fact that operand 0 of the condition is the before-block
    // argument must not make column 0 invariant (its value is `0` on the first trip and `%a`
    // afterwards).
    // CHECK-LABEL: @foreign_block_arg(
    // CHECK-SAME: [[A:%[0-9]+]]: i32, [[B:%[0-9]+]]: i32)
    // CHECK-NEXT: [[TEN:%[0-9]+]] = arith.constant 10 : i32;
    // CHECK-NEXT: [[ZERO:%[0-9]+]] = arith.constant 0 : i32;
    // CHECK-NEXT: [[R0:%[0-9]+]], [[R1:%[0-9]+]] = scf.while [[ZERO]], [[B]] before {
    // CHECK-NEXT: ^{{block[0-9]+}}([[X:%[0-9]+]]: i32, [[Y:%[0-9]+]]: i32):
    // CHECK-NEXT: [[C:%[0-9]+]] = arith.cmpi ult [[Y]], [[TEN]];
    // CHECK-NEXT: scf.condition [[C]], [[X]], [[Y]] : (i1, i32, i32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^{{block[0-9]+}}([[P:%[0-9]+]]: i32, [[Q:%[0-9]+]]: i32):
    // CHECK-NEXT: [[S:%[0-9]+]] = arith.add [[Q]], [[P]]
    // CHECK-NEXT: scf.yield [[A]], [[S]] : (i32, i32);
    // CHECK-NEXT: } : (i32, i32) -> (i32, i32);
    builtin.function public extern("C") @foreign_block_arg(%a: i32, %b: i32) -> i32 {
        %c10 = arith.constant 10 : i32;
        %c0 = arith.constant 0 : i32;
        %res0, %res1 = scf.while %c0, %b before {
        ^before(%iter0: i32, %iter1: i32):
            %cond = arith.cmpi ult %iter1, %c10;
            scf.condition %cond, %iter0, %iter1 : (i1, i32, i32);
        } after {
        ^after(%fwd0: i32, %fwd1: i32):
            %sum = arith.add %fwd1, %fwd0 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
            scf.yield %a, %sum : (i32, i32);
        } : (i32, i32) -> (i32, i32);
        %sum2 = arith.add %res0, %res1 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
        builtin.ret %sum2 : (i32);
    };

    // Negative: the yield operand for column 0 is after-block argument 0, but the condition
    // forwards a value computed from the before-block argument, so the column changes every
    // trip.
    // CHECK-LABEL: @forwarded_other_value(
    // CHECK-SAME: [[A:%[0-9]+]]: i32, [[B:%[0-9]+]]: i32)
    // CHECK-NEXT: [[TEN:%[0-9]+]] = arith.constant 10 : i32;
    // CHECK-NEXT: [[ONE:%[0-9]+]] = arith.constant 1 : i32;
    // CHECK-NEXT: [[R0:%[0-9]+]], [[R1:%[0-9]+]] = scf.while [[A]], [[B]] before {
    // CHECK-NEXT: ^{{block[0-9]+}}([[X:%[0-9]+]]: i32, [[Y:%[0-9]+]]: i32):
    // CHECK-NEXT: [[S:%[0-9]+]] = arith.add [[X]], [[ONE]]
    // CHECK-NEXT: [[C:%[0-9]+]] = arith.cmpi ult [[Y]], [[TEN]];
    // CHECK-NEXT: scf.condition [[C]], [[S]], [[Y]] : (i1, i32, i32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^{{block[0-9]+}}([[P:%[0-9]+]]: i32, [[Q:%[0-9]+]]: i32):
    // CHECK-NEXT: [[N:%[0-9]+]] = arith.add [[Q]], [[P]]
    // CHECK-NEXT: scf.yield [[P]], [[N]] : (i32, i32);
    // CHECK-NEXT: } : (i32, i32) -> (i32, i32);
    builtin.function public extern("C") @forwarded_other_value(%a: i32, %b: i32) -> i32 {
        %c10 = arith.constant 10 : i32;
        %c1 = arith.constant 1 : i32;
        %res0, %res1 = scf.while %a, %b before {
        ^before(%iter0: i32, %iter1: i32):
            %sum = arith.add %iter0, %c1 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
            %cond = arith.cmpi ult %iter1, %c10;
            scf.condition %cond, %sum, %iter1 : (i1, i32, i32);
        } after {
        ^after(%fwd0: i32, %fwd1: i32):
            %sum2 = arith.add %fwd1, %fwd0 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
            scf.yield %fwd0, %sum2 : (i32, i32);
        } : (i32, i32) -> (i32, i32);
        %sum3 = arith.add %res0, %res1 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
        builtin.ret %sum3 : (i32);
    };

    // Case 2 with a permuted condition: the condition forwards the before-block arguments in
    // swapped order, so column 0 yields after-block argument 1, which carries before-block
    // argument 0. Column 0 is invariant (the yielded index differs from the column), column 1 is
    // computed.
    // CHECK-LABEL: @yield_forwarded_permuted(
    // CHECK-SAME: [[A:%[0-9]+]]: i32, [[B:%[0-9]+]]: i32)
    // CHECK-NEXT: [[TEN:%[0-9]+]] = arith.constant 10 : i32;
    // CHECK-NEXT: [[R0:%[0-9]+]], [[R1:%[0-9]+]] = scf.while [[B]] before {
    // CHECK-NEXT: ^{{block[0-9]+}}([[Y:%[0-9]+]]: i32):
    // CHECK-NEXT: [[C:%[0-9]+]] = arith.cmpi ult [[Y]], [[TEN]];
    // CHECK-NEXT: scf.condition [[C]], [[Y]], [[A]] : (i1, i32, i32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^{{block[0-9]+}}([[P:%[0-9]+]]: i32, [[Q:%[0-9]+]]: i32):
    // CHECK-NEXT: [[S:%[0-9]+]] = arith.add [[P]], [[Q]]
    // CHECK-NEXT: scf.yield [[S]] : (i32);
    // CHECK-NEXT: } : (i32) -> (i32, i32);
    // CHECK-NEXT: arith.add [[R0]], [[R1]]
    builtin.function public extern("C") @yield_forwarded_permuted(%a: i32, %b: i32) -> i32 {
        %c10 = arith.constant 10 : i32;
        %res0, %res1 = scf.while %a, %b before {
        ^before(%iter0: i32, %iter1: i32):
            %cond = arith.cmpi ult %iter1, %c10;
            scf.condition %cond, %iter1, %iter0 : (i1, i32, i32);
        } after {
        ^after(%fwd0: i32, %fwd1: i32):
            %sum = arith.add %fwd0, %fwd1 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
            scf.yield %fwd1, %sum : (i32, i32);
        } : (i32, i32) -> (i32, i32);
        %sum2 = arith.add %res0, %res1 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
        builtin.ret %sum2 : (i32);
    };

    // Negative: an inner loop sits in the after block of an outer loop, and the inner column 0
    // yields argument 0 of the OUTER after block while the inner condition forwards inner
    // before-block argument 0 at index 0. A yielded block argument only mirrors a condition
    // operand when it belongs to the loop's own after block, so inner column 0 is not invariant
    // (its value is `1` on the first trip and the outer argument afterwards). Nothing changes.
    // CHECK-LABEL: @nested_after_arg(
    // CHECK-SAME: [[A:%[0-9]+]]: i32, [[B:%[0-9]+]]: i32)
    // CHECK-NEXT: [[TEN:%[0-9]+]] = arith.constant 10 : i32;
    // CHECK-NEXT: [[ONE:%[0-9]+]] = arith.constant 1 : i32;
    // CHECK-NEXT: [[R0:%[0-9]+]], [[R1:%[0-9]+]] = scf.while [[A]], [[B]] before {
    // CHECK-NEXT: ^{{block[0-9]+}}([[X:%[0-9]+]]: i32, [[Y:%[0-9]+]]: i32):
    // CHECK-NEXT: [[C:%[0-9]+]] = arith.cmpi ult [[Y]], [[TEN]];
    // CHECK-NEXT: scf.condition [[C]], [[X]], [[Y]] : (i1, i32, i32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^{{block[0-9]+}}([[P:%[0-9]+]]: i32, [[Q:%[0-9]+]]: i32):
    // CHECK-NEXT: [[I0:%[0-9]+]], [[I1:%[0-9]+]] = scf.while [[ONE]], [[Q]] before {
    // CHECK-NEXT: ^{{block[0-9]+}}([[U:%[0-9]+]]: i32, [[V:%[0-9]+]]: i32):
    // CHECK-NEXT: [[IC:%[0-9]+]] = arith.cmpi ult [[V]], [[TEN]];
    // CHECK-NEXT: scf.condition [[IC]], [[U]], [[V]] : (i1, i32, i32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^{{block[0-9]+}}([[G:%[0-9]+]]: i32, [[H:%[0-9]+]]: i32):
    // CHECK-NEXT: [[S:%[0-9]+]] = arith.add [[H]], [[G]]
    // CHECK-NEXT: scf.yield [[P]], [[S]] : (i32, i32);
    // CHECK-NEXT: } : (i32, i32) -> (i32, i32);
    // CHECK-NEXT: [[T:%[0-9]+]] = arith.add [[I0]], [[I1]]
    // CHECK-NEXT: scf.yield [[T]], [[T]] : (i32, i32);
    // CHECK-NEXT: } : (i32, i32) -> (i32, i32);
    // CHECK-NEXT: arith.add [[R0]], [[R1]]
    builtin.function public extern("C") @nested_after_arg(%a: i32, %b: i32) -> i32 {
        %c10 = arith.constant 10 : i32;
        %c1 = arith.constant 1 : i32;
        %res0, %res1 = scf.while %a, %b before {
        ^before(%iter0: i32, %iter1: i32):
            %cond = arith.cmpi ult %iter1, %c10;
            scf.condition %cond, %iter0, %iter1 : (i1, i32, i32);
        } after {
        ^after(%fwd0: i32, %fwd1: i32):
            %res2_0, %res2_1 = scf.while %c1, %fwd1 before {
            ^before2(%iter0_2: i32, %iter1_2: i32):
                %cond2 = arith.cmpi ult %iter1_2, %c10;
                scf.condition %cond2, %iter0_2, %iter1_2 : (i1, i32, i32);
            } after {
            ^after2(%fwd0_2: i32, %fwd1_2: i32):
                %sum = arith.add %fwd1_2, %fwd0_2 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
                scf.yield %fwd0, %sum : (i32, i32);
            } : (i32, i32) -> (i32, i32);
            %sum2 = arith.add %res2_0, %res2_1 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
            scf.yield %sum2, %sum2 : (i32, i32);
        } : (i32, i32) -> (i32, i32);
        %sum3 = arith.add %res0, %res1 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
        builtin.ret %sum3 : (i32);
    };

    // Case 1 with a debug use: the invariant before-block argument is also described by a
    // `di.debug_value`, which is replaced like any other use and now describes the initial value.
    // CHECK-LABEL: @debug_use(
    // CHECK-SAME: [[A:%[0-9]+]]: i32, [[B:%[0-9]+]]: i32)
    // CHECK-NEXT: [[TEN:%[0-9]+]] = arith.constant 10 : i32;
    // CHECK-NEXT: [[R0:%[0-9]+]], [[R1:%[0-9]+]] = scf.while [[B]] before {
    // CHECK-NEXT: ^{{block[0-9]+}}([[Y:%[0-9]+]]: i32):
    // CHECK-NEXT: di.debug_value [[A]] <{ variable = #di.variable<{ name = "k", file = "test.rs", line = 2 }>, expression = #di.expression<[]> }> : (i32);
    // CHECK-NEXT: [[C:%[0-9]+]] = arith.cmpi ult [[Y]], [[TEN]];
    // CHECK-NEXT: scf.condition [[C]], [[A]], [[Y]] : (i1, i32, i32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^{{block[0-9]+}}([[P:%[0-9]+]]: i32, [[Q:%[0-9]+]]: i32):
    // CHECK-NEXT: [[S:%[0-9]+]] = arith.add [[Q]], [[P]]
    // CHECK-NEXT: scf.yield [[S]] : (i32);
    // CHECK-NEXT: } : (i32) -> (i32, i32);
    // CHECK-NEXT: arith.add [[R0]], [[R1]]
    builtin.function public extern("C") @debug_use(%a: i32, %b: i32) -> i32 {
        %c10 = arith.constant 10 : i32;
        %res0, %res1 = scf.while %a, %b before {
        ^before(%iter0: i32, %iter1: i32):
            di.debug_value %iter0 <{ variable = #di.variable<{ name = "k", file = "test.rs", line = 2 }>, expression = #di.expression<[]> }> : (i32);
            %cond = arith.cmpi ult %iter1, %c10;
            scf.condition %cond, %iter0, %iter1 : (i1, i32, i32);
        } after {
        ^after(%fwd0: i32, %fwd1: i32):
            %sum = arith.add %fwd1, %fwd0 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
            scf.yield %a, %sum : (i32, i32);
        } : (i32, i32) -> (i32, i32);
        %sum2 = arith.add %res0, %res1 <{ overflow = #builtin.overflow<unchecked unsigned> }>;
        builtin.ret %sum2 : (i32);
    };
};
