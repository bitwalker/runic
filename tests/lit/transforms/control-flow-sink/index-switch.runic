// RUN: runic-opt %s -p control-flow-sink | filecheck %s
// RUN: runic-opt %s -p control-flow-sink | runic-opt - --verify-roundtrip | filecheck %s

// A case of an `scf.index_switch` runs at most once, so an effect-free operation whose only user
// is in that case moves into it, as `scf.index_switch` says how often its regions run
// (`transforms/control-flow-sink/regions.runic` holds `scf.if` and `scf.while`). A value used in
// two cases stays. The second RUN line reads the output back.
builtin.module public @control_flow_sink_index_switch {
    // CHECK-LABEL: @into_case(
    // CHECK-SAME: [[S:%[0-9]+]]: i32, [[A:%[0-9]+]]: i32) -> i32 {
    // CHECK-NEXT: [[BOTH:%[0-9]+]] = arith.mul [[A]], [[A]];
    // CHECK-NEXT: [[R:%[0-9]+]] = scf.index_switch [[S]]
    // CHECK-NEXT: case 1 {
    // CHECK-NEXT: [[SUM:%[0-9]+]] = arith.add [[A]], [[BOTH]];
    // CHECK-NEXT: scf.yield [[SUM]] : (i32);
    // CHECK-NEXT: }
    // CHECK-NEXT: default {
    // CHECK-NEXT: scf.yield [[BOTH]] : (i32);
    // CHECK-NEXT: } : (i32);
    // CHECK-NEXT: builtin.ret [[R]] : (i32);
    builtin.function public extern("C") @into_case(%s: i32, %a: i32) -> i32 {
        %both = arith.mul %a, %a;
        %sum = arith.add %a, %both;
        %r = scf.index_switch %s
        case 1 {
            scf.yield %sum : (i32);
        }
        default {
            scf.yield %both : (i32);
        } : (i32);
        builtin.ret %r : (i32);
    };
};
