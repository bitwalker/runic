// RUN: runic-opt %s | filecheck %s
// RUN: runic-opt %s -p dce | filecheck %s
// RUN: runic-opt %s -p cse | filecheck %s
// RUN: runic-opt %s -p sccp | filecheck %s
// RUN: runic-opt %s -p canonicalizer | filecheck %s
// RUN: runic-opt %s -p control-flow-sink | filecheck %s
// RUN: runic-opt %s -p sink-operand-defs | filecheck %s
// RUN: runic-opt %s -p "recursive(builtin.function(local2reg))" | filecheck %s
// RUN: runic-opt %s -p cfg-to-scf | filecheck %s
// RUN: runic-opt %s -p 'canonicalizer,cse,sccp,canonicalizer,dce' | filecheck %s
// RUN: runic-opt %s -p 'canonicalizer,cse,sccp,canonicalizer,dce' | runic-opt - --verify-roundtrip | filecheck %s

// The initializer of a global is not code that runs but the value the global holds: its last
// operation is the value, and no operation uses that result. No pass removes, merges, folds or
// moves an operation of an initializer, so a definition stays a definition and every operation
// of the initializer stays, even an intermediate that nothing else uses. Every RUN line checks
// the same output.
builtin.module public @global_initializers {
    // CHECK: builtin.global_variable public @data : array<i8; 2> {
    // CHECK-NEXT: builtin.bytes "0a0b" : array<i8; 2>;
    // CHECK-NEXT: };
    builtin.global_variable public @data : array<i8; 2> {
        %b = builtin.bytes "0a0b" : array<i8; 2>;
    };

    // CHECK: wasm.global public @g : i32 {
    // CHECK-NEXT: [[A:%[0-9]+]] = wasm.const 6 : i32;
    // CHECK-NEXT: [[B:%[0-9]+]] = wasm.const 7 : i32;
    // CHECK-NEXT: wasm.mul [[A]], [[B]];
    // CHECK-NEXT: };
    wasm.global public @g : i32 {
        %a = wasm.const 6 : i32;
        %b = wasm.const 7 : i32;
        %p = wasm.mul %a, %b;
    };

    // The value of an initializer is its last operation: a later operation equal to an earlier
    // one is not merged with it, so `2; 1; 2` stays and the value stays 2.
    // CHECK: builtin.global_variable public @duplicate : i32 {
    // CHECK-NEXT: arith.constant 2 : i32;
    // CHECK-NEXT: arith.constant 1 : i32;
    // CHECK-NEXT: arith.constant 2 : i32;
    // CHECK-NEXT: };
    builtin.global_variable public @duplicate : i32 {
        %a = arith.constant 2 : i32;
        %b = arith.constant 1 : i32;
        %c = arith.constant 2 : i32;
    };

    // CHECK: wasm.global public @wasm_duplicate : i32 {
    // CHECK-NEXT: wasm.const 2 : i32;
    // CHECK-NEXT: wasm.const 1 : i32;
    // CHECK-NEXT: wasm.const 2 : i32;
    // CHECK-NEXT: };
    wasm.global public @wasm_duplicate : i32 {
        %a = wasm.const 2 : i32;
        %b = wasm.const 1 : i32;
        %c = wasm.const 2 : i32;
    };

    // An intermediate that nothing uses stays, and a constant used twice is neither copied nor
    // moved.
    // CHECK: builtin.global_variable public @shared : i32 {
    // CHECK-NEXT: arith.constant 1 : i32;
    // CHECK-NEXT: arith.add
    // CHECK-NEXT: arith.add
    // CHECK-NEXT: arith.constant 9 : i32;
    // CHECK-NEXT: };
    builtin.global_variable public @shared : i32 {
        %b = arith.constant 1 : i32;
        %c = arith.add %b, %b;
        %d = arith.add %b, %b;
        %e = arith.constant 9 : i32;
    };

    // CHECK: wasm.global public @wasm_shared : i32 {
    // CHECK-NEXT: wasm.const 1 : i32;
    // CHECK-NEXT: wasm.add
    // CHECK-NEXT: wasm.add
    // CHECK-NEXT: };
    wasm.global public @wasm_shared : i32 {
        %b = wasm.const 1 : i32;
        %c = wasm.add %b, %b;
        %d = wasm.add %b, %b;
    };

    // Equal constants in a function beside the globals do not reach into them, nor they into it.
    // CHECK: wasm.global public @twin : i32 {
    // CHECK-NEXT: wasm.const 2 : i32;
    // CHECK-NEXT: };
    wasm.global public @twin : i32 {
        %a = wasm.const 2 : i32;
    };
    // CHECK: builtin.function public extern("C") @beside() -> i32 {
    builtin.function public extern("C") @beside() -> i32 {
        %a = wasm.const 2 : i32;
        %b = wasm.const 2 : i32;
        %c = wasm.add %a, %b;
        builtin.ret %c : (i32);
    };
};
