// RUN: runic-opt %s -p dce | filecheck %s
// RUN: runic-opt %s -p dce | runic-opt - --verify-roundtrip | filecheck %s

// Dead-code elimination keeps a region operation whose results are unused, even when nothing in
// its regions has an effect: an operation that holds a terminator is taken to carry an exit
// (`scf.yield` included), which `scf` documents as deliberate. The unused sum beside it is
// erased, so the test fails when the pass does not run. (On the ledger: whether an unused
// `scf.if` of effect-free regions should go; this case changes when that is decided.)
builtin.module public @dce_region_operations {
    // CHECK-LABEL: @unused_if(
    // CHECK-SAME: [[C:%[0-9]+]]: i1, [[A:%[0-9]+]]: i32) {
    // CHECK-NEXT: {{%[0-9]+}} = scf.if [[C]] then {
    // CHECK-NEXT: scf.yield [[A]] : (i32);
    // CHECK-NEXT: } else {
    // CHECK-NEXT: scf.yield [[A]] : (i32);
    // CHECK-NEXT: } : (i1) -> (i32);
    // CHECK-NEXT: builtin.ret;
    builtin.function public extern("C") @unused_if(%c: i1, %a: i32) {
        %r = scf.if %c then {
            scf.yield %a : (i32);
        } else {
            scf.yield %a : (i32);
        } : (i1) -> (i32);
        %dead = arith.add %a, %a;
        builtin.ret;
    };
};
