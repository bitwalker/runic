// RUN: runic-opt %s -p dce | filecheck %s
// RUN: runic-opt %s -p dce | runic-opt - --verify-roundtrip | filecheck %s

// What dead-code elimination erases: an operation whose results are all unused and that has no
// side effects, and with it what only it used. What it keeps: an assertion (a write, with no
// result) and what it reads, a store, an operation with unknown effects, a call whose callee
// states no effects or allocates what the call does not define, and an indirect call, with the
// reference it calls. A call whose callee declares no effects, or only the allocation of the
// call's own result, is erased when unused. The second RUN line reads the output back.
builtin.module public @dce_effects {
    builtin.function public extern("C") @pure(i32) -> i32 effects();
    builtin.function public extern("C") @unknown(i32) -> i32;
    builtin.function public extern("C") @allocates() -> ptr<i8> effects(allocate(result 0));
    builtin.function public extern("C") @allocates_elsewhere() effects(allocate);

    // The unused sum goes, and the product that only it read; the comparison stays for the
    // assertion.
    // CHECK-LABEL: @assert_survives(
    // CHECK-SAME: [[A:%[0-9]+]]: i32, [[B:%[0-9]+]]: i32) {
    // CHECK-NEXT: [[C:%[0-9]+]] = arith.cmpi ult [[A]], [[B]];
    // CHECK-NEXT: cf.assert [[C]], "m";
    // CHECK-NEXT: builtin.ret;
    builtin.function public extern("C") @assert_survives(%a: i32, %b: i32) {
        %product = arith.mul %a, %b;
        %sum = arith.add %a, %product;
        %c = arith.cmpi ult %a, %b;
        cf.assert %c, "m";
        builtin.ret;
    };

    // CHECK-LABEL: @effects_survive(
    // CHECK-SAME: [[P:%[0-9]+]]: ptr<i32>, [[V:%[0-9]+]]: i32) {
    // CHECK-NEXT: test.store [[P]], [[V]] : (ptr<i32>, i32);
    // CHECK-NEXT: {{%[0-9]+}} = test.effects <{ known = #builtin.bool<false> }>;
    // CHECK-NEXT: builtin.ret;
    builtin.function public extern("C") @effects_survive(%p: ptr<i32>, %v: i32) {
        test.store %p, %v : (ptr<i32>, i32);
        %e = test.effects <{ known = #builtin.bool<false> }>;
        %loaded = test.load %p;
        builtin.ret;
    };

    // CHECK-LABEL: @calls(
    // CHECK-SAME: [[A:%[0-9]+]]: i32) {
    // CHECK-NEXT: {{%[0-9]+}} = builtin.call @unknown([[A]]) : extern("C") (i32) -> i32;
    // CHECK-NEXT: builtin.call @allocates_elsewhere() : extern("C") ();
    // CHECK-NEXT: builtin.ret;
    builtin.function public extern("C") @calls(%a: i32) {
        %1 = builtin.call @pure(%a) : extern("C") (i32) -> i32;
        %2 = builtin.call @unknown(%a) : extern("C") (i32) -> i32;
        %3 = builtin.call @allocates() : extern("C") () -> ptr<i8>;
        builtin.call @allocates_elsewhere() : extern("C") ();
        builtin.ret;
    };

    // CHECK-LABEL: @indirect_calls(
    // CHECK-SAME: [[A:%[0-9]+]]: i32) {
    // CHECK-NEXT: [[F:%[0-9]+]] = builtin.function_ref @pure : (i32) -> i32;
    // CHECK-NEXT: {{%[0-9]+}} = builtin.call_indirect [[F]]([[A]]) : extern("C") (i32) -> i32;
    // CHECK-NEXT: builtin.ret;
    builtin.function public extern("C") @indirect_calls(%a: i32) {
        %f = builtin.function_ref @pure : (i32) -> i32;
        %1 = builtin.call_indirect %f(%a) : extern("C") (i32) -> i32;
        %g = builtin.function_ref @pure : (i32) -> i32;
        builtin.ret;
    };
};
