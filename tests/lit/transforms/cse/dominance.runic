// RUN: runic-opt %s -p cse | filecheck %s
// RUN: runic-opt %s -p cse | runic-opt - --verify-roundtrip | filecheck %s

// CSE follows the dominance tree down, never up. An operation in a nested region is replaced by an
// equal one in a region that encloses it: the constant 1 in the `before` region of the `scf.while`
// is replaced by the function's constant 1. Across the blocks of a region, an operation is replaced
// by an equal one in a block that dominates its own, and not by one in a block that does not. The
// second RUN line reads the output back.
builtin.module public @cse_dominance {
    // CHECK-LABEL: @down_propagate_while(
    // CHECK-SAME: ) {
    // CHECK-NEXT: [[ZERO:%[0-9]+]] = arith.constant 0 : i32;
    // CHECK-NEXT: [[ONE:%[0-9]+]] = arith.constant 1 : i32;
    // CHECK-NEXT: [[FOUR:%[0-9]+]] = arith.constant 4 : i32;
    // CHECK-NEXT: {{%[0-9]+}}, {{%[0-9]+}} = scf.while [[ZERO]], [[ONE]] before {
    // CHECK-NEXT: ^{{block[0-9]+}}([[I:%[0-9]+]]: i32, [[J:%[0-9]+]]: i32):
    // CHECK-NEXT: [[NEXT:%[0-9]+]] = arith.add [[I]], [[ONE]];
    // CHECK-NEXT: [[LT:%[0-9]+]] = arith.cmpi slt [[NEXT]], [[FOUR]];
    // CHECK-NEXT: scf.condition [[LT]], [[NEXT]], [[J]] : (i1, i32, i32);
    // CHECK-NEXT: } after {
    // CHECK-NEXT: ^{{block[0-9]+}}([[X:%[0-9]+]]: i32, [[Y:%[0-9]+]]: i32):
    // CHECK-NEXT: scf.yield [[X]], [[Y]] : (i32, i32);
    // CHECK-NEXT: } : (i32, i32) -> (i32, i32);
    // CHECK-NEXT: builtin.ret;
    builtin.function public extern("C") @down_propagate_while() {
        %zero = arith.constant 0 : i32;
        %one = arith.constant 1 : i32;
        %four = arith.constant 4 : i32;
        %r0, %r1 = scf.while %zero, %one before {
        ^before(%i: i32, %j: i32):
            %one_again = arith.constant 1 : i32;
            %next = arith.add %i, %one_again;
            %lt = arith.cmpi slt %next, %four;
            scf.condition %lt, %next, %j : (i1, i32, i32);
        } after {
        ^after(%x: i32, %y: i32):
            scf.yield %x, %y : (i32, i32);
        } : (i32, i32) -> (i32, i32);
        builtin.ret;
    };

    // The entry block dominates ^then: the constant 1 there is replaced by the entry's.
    // CHECK-LABEL: @down_propagate_cfg(
    // CHECK-SAME: [[COND:%[0-9]+]]: i1) -> i32 {
    // CHECK-NEXT: [[ONE:%[0-9]+]] = arith.constant 1 : i32;
    // CHECK-NEXT: cf.cond_br [[COND]] ^[[THEN:block[0-9]+]], ^[[JOIN:block[0-9]+]]([[ONE]] : i32) : (i1);
    // CHECK-NEXT: ^[[THEN]]:
    // CHECK-NEXT: cf.br ^[[JOIN]]([[ONE]] : i32);
    // CHECK-NEXT: ^[[JOIN]]([[ARG:%[0-9]+]]: i32):
    // CHECK-NEXT: builtin.ret [[ARG]] : (i32);
    builtin.function public extern("C") @down_propagate_cfg(%cond: i1) -> i32 {
        %one = arith.constant 1 : i32;
        cf.cond_br %cond ^then, ^join(%one : i32) : (i1);
    ^then:
        %one_again = arith.constant 1 : i32;
        cf.br ^join(%one_again : i32);
    ^join(%arg: i32):
        builtin.ret %arg : (i32);
    };

    // ^then does not dominate ^join, which the entry block also branches to: the constant 1 in
    // ^join is not replaced by the one in ^then, and both stay.
    // CHECK-LABEL: @up_propagate_cfg(
    // CHECK-SAME: [[COND:%[0-9]+]]: i1) -> i32 {
    // CHECK-NEXT: [[ZERO:%[0-9]+]] = arith.constant 0 : i32;
    // CHECK-NEXT: cf.cond_br [[COND]] ^[[THEN:block[0-9]+]], ^[[JOIN:block[0-9]+]]([[ZERO]] : i32) : (i1);
    // CHECK-NEXT: ^[[THEN]]:
    // CHECK-NEXT: [[ONE:%[0-9]+]] = arith.constant 1 : i32;
    // CHECK-NEXT: cf.br ^[[JOIN]]([[ONE]] : i32);
    // CHECK-NEXT: ^[[JOIN]]([[ARG:%[0-9]+]]: i32):
    // CHECK-NEXT: [[ONE_AGAIN:%[0-9]+]] = arith.constant 1 : i32;
    // CHECK-NEXT: [[SUM:%[0-9]+]] = arith.add [[ARG]], [[ONE_AGAIN]];
    // CHECK-NEXT: builtin.ret [[SUM]] : (i32);
    builtin.function public extern("C") @up_propagate_cfg(%cond: i1) -> i32 {
        %zero = arith.constant 0 : i32;
        cf.cond_br %cond ^then, ^join(%zero : i32) : (i1);
    ^then:
        %one = arith.constant 1 : i32;
        cf.br ^join(%one : i32);
    ^join(%arg: i32):
        %one_again = arith.constant 1 : i32;
        %sum = arith.add %arg, %one_again;
        builtin.ret %sum : (i32);
    };
};
