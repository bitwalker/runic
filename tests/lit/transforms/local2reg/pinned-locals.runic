// RUN: runic-opt %s -p local2reg | filecheck %s
// RUN: runic-opt %s -p local2reg | runic-opt - --verify-roundtrip | filecheck %s

// A local that an operation other than its loads and stores names is pinned: it is not promoted,
// and its stores are kept. An operation names a local in a property or an attribute; one whose
// effects are unknown is not taken to use a local it does not name. The second RUN line reads the
// output back.
builtin.module public @local2reg_pinned_locals {
    // `test.effects` has unknown effects and names local 0 in an attribute: nothing changes.
    // CHECK-LABEL: @unknown_effects_naming_the_local(
    // CHECK-SAME: [[X:%[0-9]+]]: i32) -> (i32, i32) locals(i32) {
    // CHECK-NEXT: builtin.store_local 0, [[X]];
    // CHECK-NEXT: [[E:%[0-9]+]] = test.effects <{ known = #builtin.bool<false> }> attributes { local = #builtin.local_variable<0, i32> };
    // CHECK-NEXT: [[L:%[0-9]+]] = builtin.load_local 0 : i32;
    // CHECK-NEXT: builtin.ret [[E]], [[L]] : (i32, i32);
    builtin.function public extern("C") @unknown_effects_naming_the_local(%x: i32) -> (i32, i32) locals(i32) {
        builtin.store_local 0, %x;
        %e = test.effects <{ known = #builtin.bool<false> }> attributes { local = #builtin.local_variable<0, i32> };
        %l = builtin.load_local 0 : i32;
        builtin.ret %e, %l : (i32, i32);
    };

    // The same operation without the attribute: local 0 is promoted.
    // CHECK-LABEL: @unknown_effects_naming_nothing(
    // CHECK-SAME: [[X:%[0-9]+]]: i32) -> (i32, i32) locals(i32) {
    // CHECK-NEXT: [[E:%[0-9]+]] = test.effects <{ known = #builtin.bool<false> }>;
    // CHECK-NEXT: builtin.ret [[E]], [[X]] : (i32, i32);
    builtin.function public extern("C") @unknown_effects_naming_nothing(%x: i32) -> (i32, i32) locals(i32) {
        builtin.store_local 0, %x;
        %e = test.effects <{ known = #builtin.bool<false> }>;
        %l = builtin.load_local 0 : i32;
        builtin.ret %e, %l : (i32, i32);
    };

    // `test.touch_local` names local 1 and only that local: local 0 is promoted, local 1 stays.
    // CHECK-LABEL: @pins_only_the_named_local(
    // CHECK-SAME: [[X:%[0-9]+]]: i32) -> (i32, i32) locals(i32, i32) {
    // CHECK-NEXT: builtin.store_local 1, [[X]];
    // CHECK-NEXT: test.touch_local <{ local = #builtin.local_variable<1, i32> }>;
    // CHECK-NEXT: [[L:%[0-9]+]] = builtin.load_local 1 : i32;
    // CHECK-NEXT: builtin.ret [[X]], [[L]] : (i32, i32);
    builtin.function public extern("C") @pins_only_the_named_local(%x: i32) -> (i32, i32) locals(i32, i32) {
        builtin.store_local 0, %x;
        builtin.store_local 1, %x;
        test.touch_local <{ local = #builtin.local_variable<1, i32> }>;
        %l0 = builtin.load_local 0 : i32;
        %l1 = builtin.load_local 1 : i32;
        builtin.ret %l0, %l1 : (i32, i32);
    };
};
