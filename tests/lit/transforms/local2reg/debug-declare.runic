// RUN: runic-opt %s -p local2reg | filecheck %s
// RUN: runic-opt %s -p local2reg | runic-opt - --verify-roundtrip | filecheck %s

// A `di.debug_declare` that names a local as a variable's storage, when local2reg promotes the
// local. The slot is no longer written, so the declaration becomes a `di.debug_value` of the
// stored value at the erased store's position. A declaration whose expression transforms the slot
// (a dereference) cannot become a plain debug value, so the slot is kept, also when its store looks
// dead. The second RUN line reads the output back.
builtin.module public @local2reg_debug_declare {
    // A direct declaration becomes a debug value of the stored value.
    // CHECK-LABEL: @l2r_test(
    // CHECK-SAME: [[X:%[0-9]+]]: i32) -> i32 locals(i32) {
    // CHECK-NEXT: di.debug_value [[X]] <{ variable = #di.variable<{ name = "x", file = "test.rs", line = 2, ty = i32 }>, expression = #di.expression<[]> }> : (i32);
    // CHECK-NEXT: [[S:%[0-9]+]] = arith.add [[X]], [[X]];
    // CHECK-NEXT: builtin.ret [[S]] : (i32);
    builtin.function public extern("C") @l2r_test(%x: i32) -> i32 locals(i32) {
        builtin.store_local 0, %x;
        di.debug_declare <{ variable = #di.variable<{ name = "x", file = "test.rs", line = 2, ty = i32 }>, expression = #di.expression<[DI_OP_local_slot(0)]> }>;
        %l = builtin.load_local 0 : i32;
        %s = arith.add %l, %l;
        builtin.ret %s : (i32);
    };

    // A transformed expression keeps the slot: its store, declaration and load stay.
    // CHECK-LABEL: @l2r_transformed_declare(
    // CHECK-SAME: [[X:%[0-9]+]]: i32) -> i32 locals(i32) {
    // CHECK-NEXT: builtin.store_local 0, [[X]];
    // CHECK-NEXT: di.debug_declare <{ variable = #di.variable<{ name = "x", file = "test.rs", line = 10, ty = i32 }>, expression = #di.expression<[DI_OP_local_slot(0), DW_OP_deref]> }>;
    // CHECK-NEXT: [[L:%[0-9]+]] = builtin.load_local 0 : i32;
    // CHECK-NEXT: builtin.ret [[L]] : (i32);
    builtin.function public extern("C") @l2r_transformed_declare(%x: i32) -> i32 locals(i32) {
        builtin.store_local 0, %x;
        di.debug_declare <{ variable = #di.variable<{ name = "x", file = "test.rs", line = 10, ty = i32 }>, expression = #di.expression<[DI_OP_local_slot(0), DW_OP_deref]> }>;
        %l = builtin.load_local 0 : i32;
        builtin.ret %l : (i32);
    };

    // Several variables may share one slot: when each declaration names the slot directly, all are
    // rewritten before the slot goes.
    // CHECK-LABEL: @l2r_multiple_declares(
    // CHECK-SAME: [[X:%[0-9]+]]: i32) -> i32 locals(i32) {
    // CHECK-NEXT: di.debug_value [[X]] <{ variable = #di.variable<{ name = "x", file = "test.rs", line = 20, ty = i32 }>, expression = #di.expression<[]> }> : (i32);
    // CHECK-NEXT: di.debug_value [[X]] <{ variable = #di.variable<{ name = "y", file = "test.rs", line = 21, ty = i32 }>, expression = #di.expression<[]> }> : (i32);
    // CHECK-NEXT: builtin.ret [[X]] : (i32);
    builtin.function public extern("C") @l2r_multiple_declares(%x: i32) -> i32 locals(i32) {
        builtin.store_local 0, %x;
        di.debug_declare <{ variable = #di.variable<{ name = "x", file = "test.rs", line = 20, ty = i32 }>, expression = #di.expression<[DI_OP_local_slot(0)]> }>;
        di.debug_declare <{ variable = #di.variable<{ name = "y", file = "test.rs", line = 21, ty = i32 }>, expression = #di.expression<[DI_OP_local_slot(0)]> }>;
        %l = builtin.load_local 0 : i32;
        builtin.ret %l : (i32);
    };

    // The same holds for a store that is dead to the program: a transformed declaration keeps it.
    // CHECK-LABEL: @l2r_dead_store_with_transformed_declare(
    // CHECK-SAME: [[X:%[0-9]+]]: i32) -> i32 locals(i32) {
    // CHECK-NEXT: builtin.store_local 0, [[X]];
    // CHECK-NEXT: di.debug_declare <{ variable = #di.variable<{ name = "x", file = "test.rs", line = 30, ty = i32 }>, expression = #di.expression<[DI_OP_local_slot(0), DW_OP_deref]> }>;
    // CHECK-NEXT: builtin.ret [[X]] : (i32);
    builtin.function public extern("C") @l2r_dead_store_with_transformed_declare(%x: i32) -> i32 locals(i32) {
        builtin.store_local 0, %x;
        di.debug_declare <{ variable = #di.variable<{ name = "x", file = "test.rs", line = 30, ty = i32 }>, expression = #di.expression<[DI_OP_local_slot(0), DW_OP_deref]> }>;
        builtin.ret %x : (i32);
    };
};
