// RUN: not runic-opt %s -p 'builtin.module(builtin.function(test-print-int-ranges))' --verify-diagnostics 2>&1 | filecheck %s

// An expectation is met only by a diagnostic of its kind, on its line. The text of the first
// expectation is that of the hint on its line, but it expects a warning; the text of the second is
// that of the hint one line above it; the third expects no location, and its text is that of a
// hint that has one. None is met, and the three hints are unexpected.

// CHECK-DAG: error: expected warning "u[10, 10]" was not produced
// CHECK-DAG: error: unexpected hint: range of result 0: u[10, 10] s[10, 10] width 32
// CHECK-DAG: error: expected hint "u[20, 20]" was not produced
// CHECK-DAG: error: unexpected hint: range of result 0: u[20, 20] s[20, 20] width 32
// CHECK-DAG: error: expected hint "u[30, 30]" was not produced
// CHECK-DAG: error: unexpected hint: range of result 0: u[30, 30] s[30, 30] width 32
builtin.module public @m {
    builtin.function public extern("C") @f() -> i32 {
        %x = arith.constant 10 : i32; // expected-warning {{u[10, 10]}}
        %y = arith.constant 20 : i32;
        // expected-hint {{u[20, 20]}}
        // expected-hint@unknown {{u[30, 30]}}
        %z = arith.constant 30 : i32;
        builtin.ret %x : (i32);
    };
};
