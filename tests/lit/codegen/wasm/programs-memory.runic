// RUN: runic-opt %s -p 'cfg-to-scf{exits=in-place},wasm-lower-frames,convert-to-wasm,wasm-verify-form' --split-input-file | filecheck %s
// RUN: runic-opt %s -p 'canonicalizer,cse,sccp,canonicalizer,dce,cfg-to-scf{exits=in-place},wasm-lower-frames,convert-to-wasm,wasm-verify-form' --split-input-file | filecheck %s --check-prefix=OPT

// Whole programs that use memory, through the lowering to Wasm form (see `programs.runic` for how
// they are run): locals in memory, a global variable, and a call through a function value.

// A function with locals in memory: a `mem.alloca` of a struct, a `mem.gep` to each field, stores
// and a load, a call of an `extern("C")` function with a pointer to the struct, and a return at
// two depths (in the arms of the `scf.if` that `cfg-to-scf` makes and after it). The alloca is a
// slot on the shadow stack: the stack pointer is lowered by 16 (the struct is 16 bytes with its
// `i64` field at 8), the slot's address is the new stack pointer, and each return restores the
// stack pointer first. The stack pointer is declared by `wasm-lower-frames`, the linear memory
// by `convert-to-wasm`.
//
// OPT-LABEL: builtin.module public @frame
// OPT: wasm.global_get @__stack_pointer
// OPT: wasm.store @__linear_memory
// OPT: wasm.store @__linear_memory
// OPT: builtin.call @fill
// OPT: wasm.global_set @__stack_pointer
// OPT: builtin.ret
// OPT: wasm.global_set @__stack_pointer
// OPT: builtin.ret
// CHECK-LABEL: builtin.module public @frame attributes { data_layout = #builtin.data_layout<little, ptr = 32> } {
// CHECK-NEXT: wasm.memory private declaration @__linear_memory : 0 attributes { link_name = #builtin.string<"__linear_memory"> };
// CHECK-NEXT: wasm.global private declaration @__stack_pointer : mut i32 attributes { link_name = #builtin.string<"__stack_pointer"> };
// CHECK-NEXT: builtin.function public extern("C") @fill(i32) -> i32;
// CHECK-NEXT: builtin.function public extern("C") @locals([[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.const 1 : i32;
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.and [[V1]], [[V2]];
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.global_get @__stack_pointer : i32;
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.const 16 : i32;
// CHECK-NEXT: [[V6:%[0-9]+]] = wasm.sub [[V4]], [[V5]];
// CHECK-NEXT: wasm.global_set @__stack_pointer, [[V6]];
// CHECK-NEXT: [[V7:%[0-9]+]] = wasm.const 8 : i32;
// CHECK-NEXT: [[V8:%[0-9]+]] = wasm.add [[V6]], [[V7]];
// CHECK-NEXT: wasm.store @__linear_memory, [[V6]], [[V0]];
// CHECK-NEXT: [[V9:%[0-9]+]] = wasm.const 9 : i64;
// CHECK-NEXT: wasm.store @__linear_memory, [[V8]], [[V9]];
// CHECK-NEXT: [[V10:%[0-9]+]] = builtin.call @fill([[V6]]) : extern("C") (i32) -> i32;
// CHECK-NEXT: wasm.if [[V3]] then {
// CHECK-NEXT: wasm.global_set @__stack_pointer, [[V4]];
// CHECK-NEXT: builtin.ret [[V10]] : (i32);
// CHECK-NEXT: } else {
// CHECK-NEXT: [[V11:%[0-9]+]] = wasm.load @__linear_memory, [[V6]] : i32;
// CHECK-NEXT: [[V12:%[0-9]+]] = wasm.add [[V11]], [[V10]];
// CHECK-NEXT: wasm.global_set @__stack_pointer, [[V4]];
// CHECK-NEXT: builtin.ret [[V12]] : (i32);
// CHECK-NEXT: } : (i32) -> ();
// CHECK-NEXT: wasm.unreachable;
// CHECK-NEXT: };
// CHECK-NEXT: };
builtin.module public @frame attributes { data_layout = #builtin.data_layout<little, ptr = 32> } {
    builtin.function public extern("C") @fill(ptr<struct<i32, i64>>) -> i32;

    builtin.function public extern("C") @locals(%x: i32, %early: i1) -> i32 {
        %s = mem.alloca struct<i32, i64>;
        %f0 = mem.gep %s, [0];
        %f1 = mem.gep %s, [1];
        mem.store %x, %f0;
        %wide = arith.constant 9 : i64;
        mem.store %wide, %f1;
        %r = builtin.call @fill(%s) : extern("C") (ptr<struct<i32, i64>>) -> i32;
        cf.cond_br %early ^leave, ^stay : (i1);
    ^leave:
        builtin.ret %r : (i32);
    ^stay:
        %v = mem.load %f0;
        %sum = arith.add %v, %r;
        builtin.ret %sum : (i32);
    };
};

// -----

// A global variable with an initializer (which is not part of a function and is left as it is),
// its address taken with `builtin.global_symbol`, read and written: the address is `wasm.data_addr`.
// The unit test of the crate runs this function with `@counter` at an address it assigns.
//
// OPT-LABEL: builtin.module public @global
// OPT: arith.constant 5 : i32;
// OPT: wasm.data_addr @counter
// OPT-NEXT: wasm.load @__linear_memory
// OPT-NEXT: wasm.add
// OPT-NEXT: wasm.store @__linear_memory
// CHECK-LABEL: builtin.module public @global attributes { data_layout = #builtin.data_layout<little, ptr = 32> } {
// CHECK-NEXT: wasm.memory private declaration @__linear_memory : 0 attributes { link_name = #builtin.string<"__linear_memory"> };
// CHECK-NEXT: builtin.global_variable public @counter : i32 {
// CHECK-NEXT: [[V0:%[0-9]+]] = arith.constant 5 : i32;
// CHECK-NEXT: builtin.yield [[V0]];
// CHECK-NEXT: };
// CHECK-NEXT: builtin.function public extern("wasm") @bump([[V0:%[0-9]+]]: i32) -> (i32, i32) {
// CHECK-NEXT: [[V1:%[0-9]+]] = wasm.data_addr @counter;
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.load @__linear_memory, [[V1]] : i32;
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.add [[V2]], [[V0]];
// CHECK-NEXT: wasm.store @__linear_memory, [[V1]], [[V3]];
// CHECK-NEXT: builtin.ret [[V2]], [[V1]] : (i32, i32);
// CHECK-NEXT: };
// CHECK-NEXT: };
builtin.module public @global attributes { data_layout = #builtin.data_layout<little, ptr = 32> } {
    builtin.global_variable public @counter : i32 {
        %five = arith.constant 5 : i32;
        builtin.yield %five;
    };

    builtin.function public extern("wasm") @bump(%by: i32) -> (i32, ptr<i32>) {
        %p = builtin.global_symbol @counter : ptr<i32>;
        %old = mem.load %p;
        %new = arith.add %old, %by;
        mem.store %new, %p;
        builtin.ret %old, %p : (i32, ptr<i32>);
    };
};

// -----

// An indirect call through a function value. A function value is an `i32`, the index of the
// function in the indirect-function table (a declared import, as the module has none): `@pick`
// joins two `builtin.function_ref`s, which are `wasm.func_index`, and `@run` keeps the result in
// a local and calls through it with `wasm.call_indirect`. (A function value cannot be stored
// with `mem.store`: a function type has no layout, so it is held in a local.) The optimizer moves
// each return into its arm of `@pick`.
//
// OPT-LABEL: builtin.module public @indirect
// OPT: @pick(
// OPT: wasm.if
// OPT-NEXT: wasm.func_index @double
// OPT-NEXT: builtin.ret
// OPT: wasm.func_index @negate
// OPT-NEXT: builtin.ret
// OPT: wasm.call_indirect @__indirect_function_table
// CHECK-LABEL: builtin.module public @indirect attributes { data_layout = #builtin.data_layout<little, ptr = 32> } {
// CHECK-NEXT: wasm.table private declaration @__indirect_function_table : 0 x !wasm.funcref attributes { link_name = #builtin.string<"__indirect_function_table"> };
// CHECK-NEXT: builtin.function public extern("wasm") @double([[V0:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V1:%[0-9]+]] = wasm.add [[V0]], [[V0]];
// CHECK-NEXT: builtin.ret [[V1]] : (i32);
// CHECK-NEXT: };
// CHECK-NEXT: builtin.function public extern("wasm") @negate([[V0:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V1:%[0-9]+]] = wasm.const 0 : i32;
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.sub [[V1]], [[V0]];
// CHECK-NEXT: builtin.ret [[V2]] : (i32);
// CHECK-NEXT: };
// CHECK-NEXT: builtin.function public extern("wasm") @pick([[V0:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V1:%[0-9]+]] = wasm.if [[V0]] then {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.func_index @double;
// CHECK-NEXT: wasm.end [[V2]] : (i32);
// CHECK-NEXT: } else {
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.func_index @negate;
// CHECK-NEXT: wasm.end [[V3]] : (i32);
// CHECK-NEXT: } : (i32) -> (i32);
// CHECK-NEXT: builtin.ret [[V1]] : (i32);
// CHECK-NEXT: };
// CHECK-NEXT: builtin.function public extern("wasm") @run([[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 locals(i32) {
// CHECK-NEXT: [[V2:%[0-9]+]] = builtin.call @pick([[V0]]) : extern("wasm") (i32) -> i32;
// CHECK-NEXT: builtin.store_local 0, [[V2]];
// CHECK-NEXT: [[V3:%[0-9]+]] = builtin.load_local 0 : i32;
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.call_indirect @__indirect_function_table, [[V3]]([[V1]]) : extern("wasm") (i32) -> i32;
// CHECK-NEXT: builtin.ret [[V4]] : (i32);
// CHECK-NEXT: };
// CHECK-NEXT: };
builtin.module public @indirect attributes { data_layout = #builtin.data_layout<little, ptr = 32> } {
    builtin.function public extern("wasm") @double(%x: i32) -> i32 {
        %r = arith.add %x, %x;
        builtin.ret %r : (i32);
    };

    builtin.function public extern("wasm") @negate(%x: i32) -> i32 {
        %zero = arith.constant 0 : i32;
        %r = arith.sub %zero, %x;
        builtin.ret %r : (i32);
    };

    builtin.function public extern("wasm") @pick(%flag: i1) -> ((i32) -> i32) {
        cf.cond_br %flag ^left, ^right : (i1);
    ^left:
        %d = builtin.function_ref @double : (i32) -> i32;
        cf.br ^join(%d : (i32) -> i32);
    ^right:
        %n = builtin.function_ref @negate : (i32) -> i32;
        cf.br ^join(%n : (i32) -> i32);
    ^join(%f: (i32) -> i32):
        builtin.ret %f : ((i32) -> i32);
    };

    builtin.function public extern("wasm") @run(%flag: i1, %x: i32) -> i32 locals((i32) -> i32) {
        %p = builtin.call @pick(%flag) : extern("wasm") (i1) -> ((i32) -> i32);
        builtin.store_local 0, %p;
        %f = builtin.load_local 0 : (i32) -> i32;
        %r = builtin.call_indirect %f(%x) : extern("wasm") (i32) -> i32;
        builtin.ret %r : (i32);
    };
};
