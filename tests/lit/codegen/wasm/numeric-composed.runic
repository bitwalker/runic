// RUN: runic-opt %s -p 'convert-to-wasm,wasm-verify-form' | filecheck %s

// The lowering of the composed integer operations of `arith` and of `cf.assert`, at `i8` (carried
// in an `i32` below its width) and `i64` (the width of its carrier), and at `i32` and `i7` where
// the lowering differs. Every result is zero-extended to `N` bits, the overflow flag included.
//
//   * `*_overflowing`, and `add`, `sub`, `mul` in a `checked` mode: the overflow flag `o` and the
//     wrapped result. Below the carrier's width a sum or a difference is exact in the carrier (of
//     the operands sign-extended, for signed) and is compared with the range; at it, the sign-bit
//     identities. A product is exact in the carrier when `2N <= W` (`i8`), in an `i64` for an
//     `i32`; an `i64` product is tested by an unsigned division of the largest magnitude that fits
//     by one operand's magnitude, whose divisor is made 1 when it is 0, so it cannot trap. A
//     checked operation traps with `wasm.unreachable` in a `wasm.if` on `o`;
//   * `min`, `max`: `select` on the comparison (of the operands sign-extended, for signed);
//   * `udivrem`, `sdivrem`: the two divisions (`sdivrem` sign-extends and masks, and below the
//     carrier's width traps, as `arith` does, when the quotient does not fit: the minimum by -1);
//   * `rotl`, `rotr`: the Wasm rotate at the carrier's width; below it the amount modulo `N` (an
//     `and` for a power of two, `rem_u` otherwise), two shifts, an `or` and a mask;
//   * `popcnt`; `clz` less the `W - N` bits above `N`; `ctz` of `x | 2^N`; `clo` and `cto` on the
//     complement in `N` bits (`cto` with bit `N` set, in the same `xor`);
//   * `cf.assert`: a `wasm.if` whose second region traps; the message is dropped.

// CHECK-LABEL: @add_overflowing_signed_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> (i32, i32) {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.extend8_s [[V0]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.extend8_s [[V1]];
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.add [[V2]], [[V3]];
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.extend8_s [[V4]];
// CHECK-NEXT: [[V6:%[0-9]+]] = wasm.ne [[V4]], [[V5]];
// CHECK-NEXT: [[V7:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V8:%[0-9]+]] = wasm.and [[V4]], [[V7]];
// CHECK-NEXT: builtin.ret [[V6]], [[V8]] : (i32, i32);

// CHECK-LABEL: @add_overflowing_signed_i64(
// CHECK-SAME: [[V0:%[0-9]+]]: i64, [[V1:%[0-9]+]]: i64) -> (i32, i64) {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.add [[V0]], [[V1]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.xor [[V2]], [[V0]];
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.xor [[V2]], [[V1]];
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.and [[V3]], [[V4]];
// CHECK-NEXT: [[V6:%[0-9]+]] = wasm.const 0 : i64;
// CHECK-NEXT: [[V7:%[0-9]+]] = wasm.lt_s [[V5]], [[V6]];
// CHECK-NEXT: builtin.ret [[V7]], [[V2]] : (i32, i64);

// CHECK-LABEL: @add_overflowing_unsigned_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> (i32, i32) {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.add [[V0]], [[V1]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.gt_u [[V2]], [[V3]];
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.and [[V2]], [[V3]];
// CHECK-NEXT: builtin.ret [[V4]], [[V5]] : (i32, i32);

// CHECK-LABEL: @add_overflowing_unsigned_i64(
// CHECK-SAME: [[V0:%[0-9]+]]: i64, [[V1:%[0-9]+]]: i64) -> (i32, i64) {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.add [[V0]], [[V1]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.lt_u [[V2]], [[V0]];
// CHECK-NEXT: builtin.ret [[V3]], [[V2]] : (i32, i64);

// CHECK-LABEL: @sub_overflowing_signed_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> (i32, i32) {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.extend8_s [[V0]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.extend8_s [[V1]];
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.sub [[V2]], [[V3]];
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.extend8_s [[V4]];
// CHECK-NEXT: [[V6:%[0-9]+]] = wasm.ne [[V4]], [[V5]];
// CHECK-NEXT: [[V7:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V8:%[0-9]+]] = wasm.and [[V4]], [[V7]];
// CHECK-NEXT: builtin.ret [[V6]], [[V8]] : (i32, i32);

// CHECK-LABEL: @sub_overflowing_signed_i64(
// CHECK-SAME: [[V0:%[0-9]+]]: i64, [[V1:%[0-9]+]]: i64) -> (i32, i64) {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.sub [[V0]], [[V1]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.xor [[V0]], [[V1]];
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.xor [[V0]], [[V2]];
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.and [[V3]], [[V4]];
// CHECK-NEXT: [[V6:%[0-9]+]] = wasm.const 0 : i64;
// CHECK-NEXT: [[V7:%[0-9]+]] = wasm.lt_s [[V5]], [[V6]];
// CHECK-NEXT: builtin.ret [[V7]], [[V2]] : (i32, i64);

// CHECK-LABEL: @sub_overflowing_unsigned_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> (i32, i32) {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.lt_u [[V0]], [[V1]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.sub [[V0]], [[V1]];
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.and [[V3]], [[V4]];
// CHECK-NEXT: builtin.ret [[V2]], [[V5]] : (i32, i32);

// CHECK-LABEL: @sub_overflowing_unsigned_i64(
// CHECK-SAME: [[V0:%[0-9]+]]: i64, [[V1:%[0-9]+]]: i64) -> (i32, i64) {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.lt_u [[V0]], [[V1]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.sub [[V0]], [[V1]];
// CHECK-NEXT: builtin.ret [[V2]], [[V3]] : (i32, i64);

// CHECK-LABEL: @mul_overflowing_signed_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> (i32, i32) {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.extend8_s [[V0]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.extend8_s [[V1]];
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.mul [[V2]], [[V3]];
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.extend8_s [[V4]];
// CHECK-NEXT: [[V6:%[0-9]+]] = wasm.ne [[V4]], [[V5]];
// CHECK-NEXT: [[V7:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V8:%[0-9]+]] = wasm.and [[V4]], [[V7]];
// CHECK-NEXT: builtin.ret [[V6]], [[V8]] : (i32, i32);

// CHECK-LABEL: @mul_overflowing_signed_i32(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> (i32, i32) {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.extend_s [[V0]] <{ ty = #builtin.type<i64> }>;
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.extend_s [[V1]] <{ ty = #builtin.type<i64> }>;
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.mul [[V2]], [[V3]];
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.extend32_s [[V4]];
// CHECK-NEXT: [[V6:%[0-9]+]] = wasm.ne [[V4]], [[V5]];
// CHECK-NEXT: [[V7:%[0-9]+]] = wasm.wrap [[V4]] <{ ty = #builtin.type<i32> }>;
// CHECK-NEXT: builtin.ret [[V6]], [[V7]] : (i32, i32);

// CHECK-LABEL: @mul_overflowing_signed_i64(
// CHECK-SAME: [[V0:%[0-9]+]]: i64, [[V1:%[0-9]+]]: i64) -> (i32, i64) {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.const 63 : i64;
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.shr_s [[V0]], [[V2]];
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.shr_s [[V1]], [[V2]];
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.xor [[V0]], [[V3]];
// CHECK-NEXT: [[V6:%[0-9]+]] = wasm.sub [[V5]], [[V3]];
// CHECK-NEXT: [[V7:%[0-9]+]] = wasm.xor [[V1]], [[V4]];
// CHECK-NEXT: [[V8:%[0-9]+]] = wasm.sub [[V7]], [[V4]];
// CHECK-NEXT: [[V9:%[0-9]+]] = wasm.xor [[V3]], [[V4]];
// CHECK-NEXT: [[V10:%[0-9]+]] = wasm.const 9223372036854775807 : i64;
// CHECK-NEXT: [[V11:%[0-9]+]] = wasm.sub [[V10]], [[V9]];
// CHECK-NEXT: [[V12:%[0-9]+]] = wasm.eqz [[V6]];
// CHECK-NEXT: [[V13:%[0-9]+]] = wasm.const 1 : i64;
// CHECK-NEXT: [[V14:%[0-9]+]] = wasm.select [[V12]], [[V13]], [[V6]];
// CHECK-NEXT: [[V15:%[0-9]+]] = wasm.div_u [[V11]], [[V14]];
// CHECK-NEXT: [[V16:%[0-9]+]] = wasm.gt_u [[V8]], [[V15]];
// CHECK-NEXT: [[V17:%[0-9]+]] = wasm.mul [[V0]], [[V1]];
// CHECK-NEXT: builtin.ret [[V16]], [[V17]] : (i32, i64);

// CHECK-LABEL: @mul_overflowing_unsigned_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> (i32, i32) {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.mul [[V0]], [[V1]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.gt_u [[V2]], [[V3]];
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.and [[V2]], [[V3]];
// CHECK-NEXT: builtin.ret [[V4]], [[V5]] : (i32, i32);

// CHECK-LABEL: @mul_overflowing_unsigned_i32(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> (i32, i32) {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.extend_u [[V0]] <{ ty = #builtin.type<i64> }>;
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.extend_u [[V1]] <{ ty = #builtin.type<i64> }>;
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.mul [[V2]], [[V3]];
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.const 4294967295 : i64;
// CHECK-NEXT: [[V6:%[0-9]+]] = wasm.gt_u [[V4]], [[V5]];
// CHECK-NEXT: [[V7:%[0-9]+]] = wasm.wrap [[V4]] <{ ty = #builtin.type<i32> }>;
// CHECK-NEXT: builtin.ret [[V6]], [[V7]] : (i32, i32);

// CHECK-LABEL: @mul_overflowing_unsigned_i64(
// CHECK-SAME: [[V0:%[0-9]+]]: i64, [[V1:%[0-9]+]]: i64) -> (i32, i64) {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.const -1 : i64;
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.eqz [[V0]];
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.const 1 : i64;
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.select [[V3]], [[V4]], [[V0]];
// CHECK-NEXT: [[V6:%[0-9]+]] = wasm.div_u [[V2]], [[V5]];
// CHECK-NEXT: [[V7:%[0-9]+]] = wasm.gt_u [[V1]], [[V6]];
// CHECK-NEXT: [[V8:%[0-9]+]] = wasm.mul [[V0]], [[V1]];
// CHECK-NEXT: builtin.ret [[V7]], [[V8]] : (i32, i64);

// CHECK-LABEL: @add_checked_signed_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.extend8_s [[V0]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.extend8_s [[V1]];
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.add [[V2]], [[V3]];
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.extend8_s [[V4]];
// CHECK-NEXT: [[V6:%[0-9]+]] = wasm.ne [[V4]], [[V5]];
// CHECK-NEXT: [[V7:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V8:%[0-9]+]] = wasm.and [[V4]], [[V7]];
// CHECK-NEXT: wasm.if [[V6]] then {
// CHECK-NEXT: wasm.unreachable;
// CHECK-NEXT: } : (i32) -> ();
// CHECK-NEXT: builtin.ret [[V8]] : (i32);

// CHECK-LABEL: @add_checked_signed_i64(
// CHECK-SAME: [[V0:%[0-9]+]]: i64, [[V1:%[0-9]+]]: i64) -> i64 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.add [[V0]], [[V1]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.xor [[V2]], [[V0]];
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.xor [[V2]], [[V1]];
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.and [[V3]], [[V4]];
// CHECK-NEXT: [[V6:%[0-9]+]] = wasm.const 0 : i64;
// CHECK-NEXT: [[V7:%[0-9]+]] = wasm.lt_s [[V5]], [[V6]];
// CHECK-NEXT: wasm.if [[V7]] then {
// CHECK-NEXT: wasm.unreachable;
// CHECK-NEXT: } : (i32) -> ();
// CHECK-NEXT: builtin.ret [[V2]] : (i64);

// CHECK-LABEL: @add_checked_unsigned_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.add [[V0]], [[V1]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.gt_u [[V2]], [[V3]];
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.and [[V2]], [[V3]];
// CHECK-NEXT: wasm.if [[V4]] then {
// CHECK-NEXT: wasm.unreachable;
// CHECK-NEXT: } : (i32) -> ();
// CHECK-NEXT: builtin.ret [[V5]] : (i32);

// CHECK-LABEL: @add_checked_unsigned_i64(
// CHECK-SAME: [[V0:%[0-9]+]]: i64, [[V1:%[0-9]+]]: i64) -> i64 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.add [[V0]], [[V1]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.lt_u [[V2]], [[V0]];
// CHECK-NEXT: wasm.if [[V3]] then {
// CHECK-NEXT: wasm.unreachable;
// CHECK-NEXT: } : (i32) -> ();
// CHECK-NEXT: builtin.ret [[V2]] : (i64);

// CHECK-LABEL: @sub_checked_signed_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.extend8_s [[V0]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.extend8_s [[V1]];
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.sub [[V2]], [[V3]];
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.extend8_s [[V4]];
// CHECK-NEXT: [[V6:%[0-9]+]] = wasm.ne [[V4]], [[V5]];
// CHECK-NEXT: [[V7:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V8:%[0-9]+]] = wasm.and [[V4]], [[V7]];
// CHECK-NEXT: wasm.if [[V6]] then {
// CHECK-NEXT: wasm.unreachable;
// CHECK-NEXT: } : (i32) -> ();
// CHECK-NEXT: builtin.ret [[V8]] : (i32);

// CHECK-LABEL: @sub_checked_signed_i64(
// CHECK-SAME: [[V0:%[0-9]+]]: i64, [[V1:%[0-9]+]]: i64) -> i64 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.sub [[V0]], [[V1]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.xor [[V0]], [[V1]];
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.xor [[V0]], [[V2]];
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.and [[V3]], [[V4]];
// CHECK-NEXT: [[V6:%[0-9]+]] = wasm.const 0 : i64;
// CHECK-NEXT: [[V7:%[0-9]+]] = wasm.lt_s [[V5]], [[V6]];
// CHECK-NEXT: wasm.if [[V7]] then {
// CHECK-NEXT: wasm.unreachable;
// CHECK-NEXT: } : (i32) -> ();
// CHECK-NEXT: builtin.ret [[V2]] : (i64);

// CHECK-LABEL: @sub_checked_unsigned_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.lt_u [[V0]], [[V1]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.sub [[V0]], [[V1]];
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.and [[V3]], [[V4]];
// CHECK-NEXT: wasm.if [[V2]] then {
// CHECK-NEXT: wasm.unreachable;
// CHECK-NEXT: } : (i32) -> ();
// CHECK-NEXT: builtin.ret [[V5]] : (i32);

// CHECK-LABEL: @sub_checked_unsigned_i64(
// CHECK-SAME: [[V0:%[0-9]+]]: i64, [[V1:%[0-9]+]]: i64) -> i64 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.lt_u [[V0]], [[V1]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.sub [[V0]], [[V1]];
// CHECK-NEXT: wasm.if [[V2]] then {
// CHECK-NEXT: wasm.unreachable;
// CHECK-NEXT: } : (i32) -> ();
// CHECK-NEXT: builtin.ret [[V3]] : (i64);

// CHECK-LABEL: @mul_checked_signed_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.extend8_s [[V0]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.extend8_s [[V1]];
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.mul [[V2]], [[V3]];
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.extend8_s [[V4]];
// CHECK-NEXT: [[V6:%[0-9]+]] = wasm.ne [[V4]], [[V5]];
// CHECK-NEXT: [[V7:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V8:%[0-9]+]] = wasm.and [[V4]], [[V7]];
// CHECK-NEXT: wasm.if [[V6]] then {
// CHECK-NEXT: wasm.unreachable;
// CHECK-NEXT: } : (i32) -> ();
// CHECK-NEXT: builtin.ret [[V8]] : (i32);

// CHECK-LABEL: @mul_checked_signed_i64(
// CHECK-SAME: [[V0:%[0-9]+]]: i64, [[V1:%[0-9]+]]: i64) -> i64 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.const 63 : i64;
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.shr_s [[V0]], [[V2]];
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.shr_s [[V1]], [[V2]];
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.xor [[V0]], [[V3]];
// CHECK-NEXT: [[V6:%[0-9]+]] = wasm.sub [[V5]], [[V3]];
// CHECK-NEXT: [[V7:%[0-9]+]] = wasm.xor [[V1]], [[V4]];
// CHECK-NEXT: [[V8:%[0-9]+]] = wasm.sub [[V7]], [[V4]];
// CHECK-NEXT: [[V9:%[0-9]+]] = wasm.xor [[V3]], [[V4]];
// CHECK-NEXT: [[V10:%[0-9]+]] = wasm.const 9223372036854775807 : i64;
// CHECK-NEXT: [[V11:%[0-9]+]] = wasm.sub [[V10]], [[V9]];
// CHECK-NEXT: [[V12:%[0-9]+]] = wasm.eqz [[V6]];
// CHECK-NEXT: [[V13:%[0-9]+]] = wasm.const 1 : i64;
// CHECK-NEXT: [[V14:%[0-9]+]] = wasm.select [[V12]], [[V13]], [[V6]];
// CHECK-NEXT: [[V15:%[0-9]+]] = wasm.div_u [[V11]], [[V14]];
// CHECK-NEXT: [[V16:%[0-9]+]] = wasm.gt_u [[V8]], [[V15]];
// CHECK-NEXT: [[V17:%[0-9]+]] = wasm.mul [[V0]], [[V1]];
// CHECK-NEXT: wasm.if [[V16]] then {
// CHECK-NEXT: wasm.unreachable;
// CHECK-NEXT: } : (i32) -> ();
// CHECK-NEXT: builtin.ret [[V17]] : (i64);

// CHECK-LABEL: @mul_checked_unsigned_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.mul [[V0]], [[V1]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.gt_u [[V2]], [[V3]];
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.and [[V2]], [[V3]];
// CHECK-NEXT: wasm.if [[V4]] then {
// CHECK-NEXT: wasm.unreachable;
// CHECK-NEXT: } : (i32) -> ();
// CHECK-NEXT: builtin.ret [[V5]] : (i32);

// CHECK-LABEL: @mul_checked_unsigned_i64(
// CHECK-SAME: [[V0:%[0-9]+]]: i64, [[V1:%[0-9]+]]: i64) -> i64 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.const -1 : i64;
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.eqz [[V0]];
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.const 1 : i64;
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.select [[V3]], [[V4]], [[V0]];
// CHECK-NEXT: [[V6:%[0-9]+]] = wasm.div_u [[V2]], [[V5]];
// CHECK-NEXT: [[V7:%[0-9]+]] = wasm.gt_u [[V1]], [[V6]];
// CHECK-NEXT: [[V8:%[0-9]+]] = wasm.mul [[V0]], [[V1]];
// CHECK-NEXT: wasm.if [[V7]] then {
// CHECK-NEXT: wasm.unreachable;
// CHECK-NEXT: } : (i32) -> ();
// CHECK-NEXT: builtin.ret [[V8]] : (i64);

// CHECK-LABEL: @min_signed_i8(
