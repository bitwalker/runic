// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.shl [[V0]], [[V1]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.and [[V2]], [[V3]];
// CHECK-NEXT: builtin.ret [[V4]] : (i32);

// CHECK-LABEL: @shr_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.shr_u [[V0]], [[V1]];
// CHECK-NEXT: builtin.ret [[V2]] : (i32);

// CHECK-LABEL: @ashr_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.extend8_s [[V0]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.shr_s [[V2]], [[V1]];
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.and [[V3]], [[V4]];
// CHECK-NEXT: builtin.ret [[V5]] : (i32);

// CHECK-LABEL: @cmp_eq_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.eq [[V0]], [[V1]];
// CHECK-NEXT: builtin.ret [[V2]] : (i32);

// CHECK-LABEL: @cmp_ult_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.lt_u [[V0]], [[V1]];
// CHECK-NEXT: builtin.ret [[V2]] : (i32);

