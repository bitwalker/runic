// CHECK-LABEL: @bnot_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V1:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.xor [[V0]], [[V1]];
