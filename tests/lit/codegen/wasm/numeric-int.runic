// RUN: runic-opt %s -p 'convert-to-wasm,wasm-verify-form' --split-input-file --verify-diagnostics | filecheck %s

// The lowering of the integer operations of `arith`, of `cf.select` and of `ub.poison`, at `i8` (a
// narrow width, carried in an `i32`), `i32`, `i40` (carried in an `i64`) and `i64`.
//
// Carried form: a value of `iN` is zero-extended to `N` bits in its carrier. Each rule keeps that:
//   * `add`, `sub`, `mul`, `neg`, `shl`: the Wasm operation, then a mask of `N` bits (none at the
//     width of the carrier);
//   * `band`, `bor`, `bxor`, `udiv`, `urem`, `shr`: the Wasm operation alone;
//   * `bnot`: `xor` with `2^N - 1`;
//   * `sdiv`, `srem`, `ashr`, the signed comparisons: sign-extend the operands from `N` (nothing at
//     the width of the carrier), then the signed Wasm operation; `sdiv`, `srem`, `ashr` mask after;
//   * `trunc`: `wrap` when the carrier narrows, then a mask; `zext`: `extend_u` when the carrier
//     widens; `sext`: sign-extend from `N`, `extend_s` when the carrier widens, then a mask.
// A shift amount of `N` or more is undefined in `arith`; the mask keeps carried form anyway.
// `arith.sdiv` of the minimum value by -1 traps in `arith`; below the carrier's width the lowering
// does not trap and gives the minimum value, which `arith` allows.
//
// An operation that no pattern lowers (here a load, left to the patterns of memory) is reported by
// the conversion, which names it.

// CHECK-LABEL: @add_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.add [[V0]], [[V1]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.and [[V2]], [[V3]];
// CHECK-NEXT: builtin.ret [[V4]] : (i32);

// CHECK-LABEL: @sub_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.sub [[V0]], [[V1]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.and [[V2]], [[V3]];
// CHECK-NEXT: builtin.ret [[V4]] : (i32);

// CHECK-LABEL: @mul_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.mul [[V0]], [[V1]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.and [[V2]], [[V3]];
// CHECK-NEXT: builtin.ret [[V4]] : (i32);

// CHECK-LABEL: @add_unchecked_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.add [[V0]], [[V1]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.and [[V2]], [[V3]];
// CHECK-NEXT: builtin.ret [[V4]] : (i32);

// CHECK-LABEL: @band_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.and [[V0]], [[V1]];
// CHECK-NEXT: builtin.ret [[V2]] : (i32);

// CHECK-LABEL: @bor_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.or [[V0]], [[V1]];
// CHECK-NEXT: builtin.ret [[V2]] : (i32);

// CHECK-LABEL: @bxor_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.xor [[V0]], [[V1]];
// CHECK-NEXT: builtin.ret [[V2]] : (i32);

// CHECK-LABEL: @udiv_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.div_u [[V0]], [[V1]];
// CHECK-NEXT: builtin.ret [[V2]] : (i32);

// CHECK-LABEL: @urem_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.rem_u [[V0]], [[V1]];
// CHECK-NEXT: builtin.ret [[V2]] : (i32);

// CHECK-LABEL: @sdiv_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.extend8_s [[V0]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.extend8_s [[V1]];
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.div_s [[V2]], [[V3]];
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V6:%[0-9]+]] = wasm.and [[V4]], [[V5]];
// CHECK-NEXT: builtin.ret [[V6]] : (i32);

// CHECK-LABEL: @srem_i8(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.extend8_s [[V0]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.extend8_s [[V1]];
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.rem_s [[V2]], [[V3]];
// CHECK-NEXT: [[V5:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V6:%[0-9]+]] = wasm.and [[V4]], [[V5]];
// CHECK-NEXT: builtin.ret [[V6]] : (i32);

