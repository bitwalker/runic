// CHECK-LABEL: @sdiv_i32(
// CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.div_s [[V0]], [[V1]];
