// CHECK-NEXT: [[V1:%[0-9]+]] = wasm.const 0 : i32;
// CHECK-NEXT: [[V2:%[0-9]+]] = wasm.sub [[V1]], [[V0]];
// CHECK-NEXT: [[V3:%[0-9]+]] = wasm.const 255 : i32;
// CHECK-NEXT: [[V4:%[0-9]+]] = wasm.and [[V2]], [[V3]];
