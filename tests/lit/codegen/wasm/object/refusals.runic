// RUN: runic-opt %s --target wasm32-unknown-unknown --stop-after object --split-input-file --verify-diagnostics
// RUN: not runic-opt %s --target wasm32-unknown-unknown --stop-after object --split-input-file 2>&1 | filecheck %s

// What a relocatable object cannot express is refused with a diagnostic that names the
// operation, and nothing is written; the same unit compiles to a complete module. Each case is
// its own input (`--split-input-file`). The second run shows each diagnostic with its label.

// CHECK: error: a relocatable object cannot express `wasm.elem` @e
// CHECK: {{\^+}} this fills a table at slots it fixes, and the linker ignores the element segments of an object: it lays out the function table itself
// CHECK: error: a relocatable object cannot express a `builtin.segment`
// CHECK: {{\^+}} this places bytes at the address 2048, and the linker places every data segment of an object itself: there is no data at a fixed address
// CHECK: error: a relocatable object cannot express passive data: `wasm.memory_init` names `passive::bytes` as a passive segment
// CHECK: {{\^+}} this names `passive::bytes` as a passive data segment, and the linker makes every data segment of an object active, with no relocation for a segment index
// CHECK: error: a relocatable object cannot express passive data: `wasm.data_drop` names `drop::bytes` as a passive segment
// CHECK: {{\^+}} this names `drop::bytes` as a passive data segment, and the linker makes every data segment of an object active, with no relocation for a segment index
// CHECK: error: a relocatable object cannot express `wasm.global` @g, whose initializer names another entity
// CHECK: {{\^+}} the initializer of this global holds the address of `init::d`, and an object has no relocation in the global section
// CHECK: error: a relocatable object cannot express a memory it defines, `wasm.memory` @mem
// CHECK: {{\^+}} this defines a memory, and the linker defines the memory of the module it links: an object imports it as `env.__linear_memory`
// CHECK: error: a relocatable object cannot define the function table `__indirect_function_table`
// CHECK: {{\^+}} this defines `__indirect_function_table`, which the linker defines itself: it refuses an object that defines it
// CHECK: error: a relocatable object cannot define the stack pointer `__stack_pointer`
// CHECK: {{\^+}} this defines `__stack_pointer`, which the linker defines itself: the link fails with a duplicate symbol
// CHECK: error: a relocatable object cannot express `wasm.ref_func` `@callee`
// CHECK: {{\^+}} this takes a reference to a function, which Wasm requires the module to declare, and the linker declares no function for `ref.func`: the linked module would not validate
// CHECK: error: a relocatable object cannot express the function `names::f` exported under two names, `one` and `two`
// CHECK: {{\^+}} this exports `names::f` as `two`, and it is exported as `one`: an object exports a function under one name
// CHECK: error: a relocatable object cannot express the export `x` of the global `g` under another name
// CHECK: {{\^+}} this exports the global `g` as `x`, and an object marks a global exported only under its own link name
// CHECK: error: a relocatable object cannot express the export `x` of the table `t` under another name
// CHECK: {{\^+}} this exports the table `t` as `x`, and an object marks a table exported only under its own link name
// CHECK: error: a relocatable object cannot express the export `x` of the memory `__linear_memory` under another name
// CHECK: {{\^+}} this exports the memory `__linear_memory` as `x`, and an object marks a memory exported only under its own link name
// CHECK: error: a relocatable object cannot express the import `g`: its declarations disagree on whether it names its host
// CHECK: {{-+}} the first declaration has no `wasm.import_module`, so the linker resolves `g` to a definition of another object
// CHECK: {{\^+}} this declaration names the host module `env` with `wasm.import_module`, so the linker imports `g` from it
// CHECK: error: a relocatable object cannot express the section `.bss.mine` of the global variable `bss::d`
// CHECK: {{\^+}} this puts `bss::d` in the section `.bss.mine`, and the linker writes no bytes for a section whose name starts with `.bss`: its contents would link to zeros
// CHECK: error: a relocatable object cannot express the section `.tdata.x` of the global variable `tls::d`
// CHECK: {{\^+}} this puts `tls::d` in the section `.tdata.x`, and the linker treats a section whose name starts with `.tdata` or `.tbss` as thread-local data, which the backend does not emit
// CHECK: error: a relocatable object cannot express `__start_a.b`: the linker defines no bounds for the section `a.b`
// CHECK: {{\^+}} this declares the start of the section `a.b`, and the linker defines `__start_<s>` and `__stop_<s>` only for a section whose name is a C identifier: letters, digits and `_`, not starting with a digit
// CHECK: error: a relocatable object cannot express the memory import `host.mem`
// CHECK: {{\^+}} this names the host module `host` with `wasm.import_module`, and the linker provides the memory itself: an object imports it as `env.__linear_memory`, and the linker exports it as `memory`
// CHECK: error: a relocatable object cannot express the memory import `env.mem`
// CHECK: {{\^+}} this declares the memory `mem`, and the linker provides the memory itself: an object imports it as `env.__linear_memory`, and the linker exports it as `memory`
// CHECK: error: a relocatable object cannot express the export `__linear_memory` of the memory `__linear_memory`
// CHECK: {{\^+}} this exports the memory as `__linear_memory`, and the linker provides and exports the memory itself, as `memory`
// CHECK: error: a relocatable object cannot express the export `hosted` of the function `hosted`, which it does not define
// CHECK: {{\^+}} this exports the function `hosted`, which the unit declares and does not define, and the linker exports only what an object defines
// CHECK: error: a relocatable object cannot express the export `hg` of the global `hg`, which it does not define
// CHECK: {{\^+}} this exports the global `hg`, which the unit declares and does not define, and the linker exports only what an object defines
// CHECK: error: a relocatable object cannot express the alias `al` of a function it does not define
// CHECK: {{\^+}} this defines `al` for a function the unit does not define, and an object defines a symbol only for a function it defines

builtin.module public @elem {
    wasm.table private @tab : 1 x !wasm.funcref;
    builtin.function public extern("C") @f(%x: i32) -> i32 {
        builtin.ret %x : (i32);
    };
    wasm.elem private @e : @tab at 0 [@f]; // expected-error {{a relocatable object cannot express `wasm.elem` @e}}
};

// -----

builtin.module public @segment {
    wasm.memory private declaration @__linear_memory : 0 attributes { link_name = "__linear_memory" };
    builtin.segment <{ offset = #builtin.i64<2048>, data = #builtin.bytes<"2a2a2a2a"> }>; // expected-error {{a relocatable object cannot express a `builtin.segment`}}
};

// -----

builtin.module public @passive {
    wasm.memory private declaration @__linear_memory : 0 attributes { link_name = "__linear_memory" };
    builtin.global_variable private @bytes : i32 { %v = arith.constant 1 : i32; builtin.yield %v; };
    builtin.function public extern("wasm") @copy(%d: i32) {
        %s = wasm.const 0 : i32;
        %n = wasm.const 4 : i32;
        wasm.memory_init @__linear_memory, @bytes, %d, %s, %n; // expected-error {{a relocatable object cannot express passive data: `wasm.memory_init` names `passive::bytes` as a passive segment}}
        builtin.ret;
    };
};

// -----

builtin.module public @drop {
    wasm.memory private declaration @__linear_memory : 0 attributes { link_name = "__linear_memory" };
    builtin.global_variable private @bytes : i32 { %v = arith.constant 1 : i32; builtin.yield %v; };
    builtin.function public extern("wasm") @drop() {
        wasm.data_drop @bytes; // expected-error {{a relocatable object cannot express passive data: `wasm.data_drop` names `drop::bytes` as a passive segment}}
        builtin.ret;
    };
};

// -----

builtin.module public @init {
    builtin.global_variable public @d : i32 { %v = arith.constant 1 : i32; builtin.yield %v; };
    wasm.global private @g : i32 { %v = wasm.data_addr @d; builtin.yield %v; }; // expected-error {{a relocatable object cannot express `wasm.global` @g, whose initializer names another entity}}
};

// -----

builtin.module public @memory {
    wasm.memory public @mem : 1; // expected-error {{a relocatable object cannot express a memory it defines, `wasm.memory` @mem}}
};

// -----

builtin.module public @table {
    wasm.table private @__indirect_function_table : 1 x !wasm.funcref; // expected-error {{a relocatable object cannot define the function table `__indirect_function_table`}}
};

// -----

builtin.module public @sp {
    wasm.global public @sp : i32 { %v = wasm.const 0 : i32; builtin.yield %v; } attributes { link_name = "__stack_pointer" }; // expected-error {{a relocatable object cannot define the stack pointer `__stack_pointer`}}
};

// -----

builtin.module public @refs {
    builtin.function public extern("wasm") @callee(%x: i32) -> i32 {
        builtin.ret %x : (i32);
    };
    builtin.function public extern("wasm") @f() -> i32 {
        %r = wasm.ref_func @callee; // expected-error {{a relocatable object cannot express `wasm.ref_func` `@callee`}}
        %z = wasm.ref_is_null %r;
        builtin.ret %z : (i32);
    };
};

// -----

builtin.module public @names {
    builtin.function public extern("C") @f(%x: i32) -> i32 { // expected-error {{a relocatable object cannot express the function `names::f` exported under two names, `one` and `two`}}
        builtin.ret %x : (i32);
    } attributes { wasm.export_name = ["one", "two"] };
};

// -----

builtin.module public @renamed {
    wasm.global private @g : i32 { %v = wasm.const 0 : i32; builtin.yield %v; } attributes { link_name = "g", wasm.export_name = "x" }; // expected-error {{a relocatable object cannot express the export `x` of the global `g` under another name}}
};

// -----

builtin.module public @renamed_table {
    wasm.table private declaration @t : 1 x !wasm.funcref attributes { link_name = "t", wasm.export_name = "x" }; // expected-error {{a relocatable object cannot express the export `x` of the table `t` under another name}}
};

// -----

builtin.module public @renamed_memory {
    wasm.memory private declaration @__linear_memory : 0 attributes { link_name = "__linear_memory", wasm.export_name = "x" }; // expected-error {{a relocatable object cannot express the export `x` of the memory `__linear_memory` under another name}}
};

// -----

builtin.world {
    builtin.module public @a {
        builtin.function public extern("wasm") @f() attributes { link_name = "g" };
    };
    builtin.module public @b {
        builtin.function public extern("wasm") @f() attributes { link_name = "g", wasm.import_module = "env" }; // expected-error {{a relocatable object cannot express the import `g`: its declarations disagree on whether it names its host}}
    };
};

// -----

builtin.module public @bss {
    builtin.global_variable private @d : i32 { %v = arith.constant 42 : i32; builtin.yield %v; } attributes { section = ".bss.mine" }; // expected-error {{a relocatable object cannot express the section `.bss.mine` of the global variable `bss::d`}}
};

// -----

builtin.module public @tls {
    builtin.global_variable private @d : i32 { %v = arith.constant 42 : i32; builtin.yield %v; } attributes { section = ".tdata.x" }; // expected-error {{a relocatable object cannot express the section `.tdata.x` of the global variable `tls::d`}}
};

// -----

builtin.module public @bounds {
    builtin.global_variable private @e : i32 { %v = arith.constant 42 : i32; builtin.yield %v; } attributes { section = "a.b" };
    builtin.global_variable public @start : i32 attributes { link_name = "__start_a.b" }; // expected-error {{a relocatable object cannot express `__start_a.b`: the linker defines no bounds for the section `a.b`}}
};

// -----

builtin.module public @hosted_memory {
    wasm.memory public declaration @mem : 1 attributes { link_name = "mem", wasm.import_module = "host" }; // expected-error {{a relocatable object cannot express the memory import `host.mem`}}
};

// -----

builtin.module public @other_memory {
    wasm.memory public declaration @mem : 1 attributes { link_name = "mem" }; // expected-error {{a relocatable object cannot express the memory import `env.mem`}}
};

// -----

builtin.module public @exported_memory {
    wasm.memory private declaration @__linear_memory : 0 attributes { link_name = "__linear_memory", wasm.export_name = "__linear_memory" }; // expected-error {{a relocatable object cannot express the export `__linear_memory` of the memory `__linear_memory`}}
};

// -----

builtin.module public @exported_function_import {
    builtin.function public extern("wasm") @hosted(i32) -> i32 attributes { link_name = "hosted", wasm.import_module = "host", wasm.export_name = "hosted" }; // expected-error {{a relocatable object cannot express the export `hosted` of the function `hosted`, which it does not define}}
};

// -----

builtin.module public @exported_global_import {
    wasm.global private declaration @hg : i32 attributes { link_name = "hg", wasm.export_name = "hg" }; // expected-error {{a relocatable object cannot express the export `hg` of the global `hg`, which it does not define}}
};

// -----

builtin.module public @alias {
    builtin.function public extern("wasm") @ext(i32) -> i32 attributes { link_name = "ext" };
    builtin.function_alias public @al -> @ext attributes { link_name = "al" }; // expected-error {{a relocatable object cannot express the alias `al` of a function it does not define}}
};
