// RUN: runic-opt %s -p 'convert-to-wasm,wasm-verify-form' | filecheck %s

// `scf.index_switch` becomes a `wasm.br_table` in nested `wasm.block`s when it is dense (at least
// three cases, and at most four values from its least case to its greatest per case), and a chain
// of `wasm.if (wasm.eq %s, k)` otherwise.

builtin.module public @control_switch attributes { data_layout = #builtin.data_layout<little, ptr = 32> } {
    // Dense from 0, with results (one narrow): the table is on the selector itself. Case `j`
    // follows the block of case `j` and branches out to the outermost block; the default follows
    // the block of the default and ends the outermost block.
    // CHECK-LABEL: @dense(
    // CHECK-SAME: [[V0:%[0-9]+]]: i32) -> (i32, i32) {
    // CHECK-NEXT: [[V1:%[0-9]+]], [[V2:%[0-9]+]] = wasm.block {
    // CHECK-NEXT: wasm.block {
    // CHECK-NEXT: wasm.block {
    // CHECK-NEXT: wasm.block {
    // CHECK-NEXT: wasm.block {
    // CHECK-NEXT: wasm.br_table [[V0]] [{
    // CHECK-NEXT: wasm.br 0 : ();
    // CHECK-NEXT: }, {
    // CHECK-NEXT: wasm.br 1 : ();
    // CHECK-NEXT: }, {
    // CHECK-NEXT: wasm.br 2 : ();
    // CHECK-NEXT: }] default {
    // CHECK-NEXT: wasm.br 3 : ();
    // CHECK-NEXT: } : (i32);
    // CHECK-NEXT: } : () -> ();
    // CHECK-NEXT: [[V3:%[0-9]+]] = wasm.const 10 : i32;
    // CHECK-NEXT: [[V4:%[0-9]+]] = wasm.const 100 : i32;
    // CHECK-NEXT: wasm.br 3 [[V3]], [[V4]] : (i32, i32);
    // CHECK-NEXT: } : () -> ();
    // CHECK-NEXT: [[V5:%[0-9]+]] = wasm.const 11 : i32;
    // CHECK-NEXT: [[V6:%[0-9]+]] = wasm.const 101 : i32;
    // CHECK-NEXT: wasm.br 2 [[V5]], [[V6]] : (i32, i32);
    // CHECK-NEXT: } : () -> ();
    // CHECK-NEXT: [[V7:%[0-9]+]] = wasm.const 12 : i32;
    // CHECK-NEXT: [[V8:%[0-9]+]] = wasm.const 102 : i32;
    // CHECK-NEXT: wasm.br 1 [[V7]], [[V8]] : (i32, i32);
    // CHECK-NEXT: } : () -> ();
    // CHECK-NEXT: [[V9:%[0-9]+]] = wasm.const 99 : i32;
    // CHECK-NEXT: wasm.end [[V9]], [[V0]] : (i32, i32);
    // CHECK-NEXT: } : () -> (i32, i32);
    // CHECK-NEXT: builtin.ret [[V1]], [[V2]] : (i32, i32);
    // CHECK-NEXT: };
    builtin.function public extern("wasm") @dense(%s: i32) -> (i8, i32) {
        %a, %b = scf.index_switch %s
        case 0 {
            %x = arith.constant 10 : i8;
            %y = arith.constant 100 : i32;
            scf.yield %x, %y : (i8, i32);
        }
        case 1 {
            %x = arith.constant 11 : i8;
            %y = arith.constant 101 : i32;
            scf.yield %x, %y : (i8, i32);
        }
        case 2 {
            %x = arith.constant 12 : i8;
            %y = arith.constant 102 : i32;
            scf.yield %x, %y : (i8, i32);
        }
        default {
            %x = arith.constant 99 : i8;
            scf.yield %x, %s : (i8, i32);
        } : (i8, i32);
        builtin.ret %a, %b : (i8, i32);
    };

    // Dense with a negative least case (-2) and a gap (0): the table is on `%s - (-2)`, and the
    // entry of the gap goes to the default.
    // CHECK-LABEL: @dense_negative(
    // CHECK-SAME: [[V0:%[0-9]+]]: i32) -> i32 {
    // CHECK-NEXT: [[V1:%[0-9]+]] = wasm.block {
    // CHECK-NEXT: wasm.block {
    // CHECK-NEXT: wasm.block {
    // CHECK-NEXT: wasm.block {
    // CHECK-NEXT: wasm.block {
    // CHECK-NEXT: [[V2:%[0-9]+]] = wasm.const -2 : i32;
    // CHECK-NEXT: [[V3:%[0-9]+]] = wasm.sub [[V0]], [[V2]];
    // CHECK-NEXT: wasm.br_table [[V3]] [{
    // CHECK-NEXT: wasm.br 0 : ();
    // CHECK-NEXT: }, {
    // CHECK-NEXT: wasm.br 1 : ();
    // CHECK-NEXT: }, {
    // CHECK-NEXT: wasm.br 3 : ();
    // CHECK-NEXT: }, {
    // CHECK-NEXT: wasm.br 2 : ();
    // CHECK-NEXT: }] default {
    // CHECK-NEXT: wasm.br 3 : ();
    // CHECK-NEXT: } : (i32);
    // CHECK-NEXT: } : () -> ();
    // CHECK-NEXT: [[V4:%[0-9]+]] = wasm.const 20 : i32;
    // CHECK-NEXT: wasm.br 3 [[V4]] : (i32);
    // CHECK-NEXT: } : () -> ();
    // CHECK-NEXT: [[V5:%[0-9]+]] = wasm.const 21 : i32;
    // CHECK-NEXT: wasm.br 2 [[V5]] : (i32);
    // CHECK-NEXT: } : () -> ();
    // CHECK-NEXT: [[V6:%[0-9]+]] = wasm.const 23 : i32;
    // CHECK-NEXT: wasm.br 1 [[V6]] : (i32);
    // CHECK-NEXT: } : () -> ();
    // CHECK-NEXT: [[V7:%[0-9]+]] = wasm.const 0 : i32;
    // CHECK-NEXT: wasm.end [[V7]] : (i32);
    // CHECK-NEXT: } : () -> (i32);
    // CHECK-NEXT: builtin.ret [[V1]] : (i32);
    // CHECK-NEXT: };
    builtin.function public extern("wasm") @dense_negative(%s: i32) -> i32 {
        %r = scf.index_switch %s
        case -2 {
            %x = arith.constant 20 : i32;
            scf.yield %x : (i32);
        }
        case -1 {
            %x = arith.constant 21 : i32;
            scf.yield %x : (i32);
        }
        case 1 {
            %x = arith.constant 23 : i32;
            scf.yield %x : (i32);
        }
        default {
            %x = arith.constant 0 : i32;
            scf.yield %x : (i32);
        } : (i32);
        builtin.ret %r : (i32);
    };

    // Sparse (three cases over 5001 values): a chain of comparisons.
    // CHECK-LABEL: @sparse(
    // CHECK-SAME: [[V0:%[0-9]+]]: i32) -> i32 {
    // CHECK-NEXT: [[V1:%[0-9]+]] = wasm.const -7 : i32;
    // CHECK-NEXT: [[V2:%[0-9]+]] = wasm.eq [[V0]], [[V1]];
    // CHECK-NEXT: [[V3:%[0-9]+]] = wasm.if [[V2]] then {
    // CHECK-NEXT: [[V4:%[0-9]+]] = wasm.const 1 : i32;
    // CHECK-NEXT: wasm.end [[V4]] : (i32);
    // CHECK-NEXT: } else {
    // CHECK-NEXT: [[V5:%[0-9]+]] = wasm.const 100 : i32;
    // CHECK-NEXT: [[V6:%[0-9]+]] = wasm.eq [[V0]], [[V5]];
    // CHECK-NEXT: [[V7:%[0-9]+]] = wasm.if [[V6]] then {
    // CHECK-NEXT: [[V8:%[0-9]+]] = wasm.const 2 : i32;
    // CHECK-NEXT: wasm.end [[V8]] : (i32);
    // CHECK-NEXT: } else {
    // CHECK-NEXT: [[V9:%[0-9]+]] = wasm.const 5000 : i32;
    // CHECK-NEXT: [[V10:%[0-9]+]] = wasm.eq [[V0]], [[V9]];
    // CHECK-NEXT: [[V11:%[0-9]+]] = wasm.if [[V10]] then {
    // CHECK-NEXT: [[V12:%[0-9]+]] = wasm.const 3 : i32;
    // CHECK-NEXT: wasm.end [[V12]] : (i32);
    // CHECK-NEXT: } else {
    // CHECK-NEXT: wasm.end [[V0]] : (i32);
    // CHECK-NEXT: } : (i32) -> (i32);
    // CHECK-NEXT: wasm.end [[V11]] : (i32);
    // CHECK-NEXT: } : (i32) -> (i32);
    // CHECK-NEXT: wasm.end [[V7]] : (i32);
    // CHECK-NEXT: } : (i32) -> (i32);
    // CHECK-NEXT: builtin.ret [[V3]] : (i32);
    // CHECK-NEXT: };
    builtin.function public extern("wasm") @sparse(%s: i32) -> i32 {
        %r = scf.index_switch %s
        case -7 {
            %x = arith.constant 1 : i32;
            scf.yield %x : (i32);
        }
        case 100 {
            %x = arith.constant 2 : i32;
            scf.yield %x : (i32);
        }
        case 5000 {
            %x = arith.constant 3 : i32;
            scf.yield %x : (i32);
        }
        default {
            scf.yield %s : (i32);
        } : (i32);
        builtin.ret %r : (i32);
    };

    // Two cases, however close, are a chain; a case that ends in an exit keeps it.
    // CHECK-LABEL: @two_cases(
    // CHECK-SAME: [[V0:%[0-9]+]]: i32, [[V1:%[0-9]+]]: i32) -> i32 {
    // CHECK-NEXT: [[V2:%[0-9]+]] = wasm.const 0 : i32;
    // CHECK-NEXT: [[V3:%[0-9]+]] = wasm.eq [[V0]], [[V2]];
    // CHECK-NEXT: [[V4:%[0-9]+]] = wasm.if [[V3]] then {
    // CHECK-NEXT: builtin.ret [[V1]] : (i32);
    // CHECK-NEXT: } else {
    // CHECK-NEXT: [[V5:%[0-9]+]] = wasm.const 1 : i32;
    // CHECK-NEXT: [[V6:%[0-9]+]] = wasm.eq [[V0]], [[V5]];
    // CHECK-NEXT: [[V7:%[0-9]+]] = wasm.if [[V6]] then {
    // CHECK-NEXT: builtin.tail_call @g([[V1]]) : extern("C") (i32) -> i32;
    // CHECK-NEXT: } else {
    // CHECK-NEXT: wasm.end [[V1]] : (i32);
    // CHECK-NEXT: } : (i32) -> (i32);
    // CHECK-NEXT: wasm.end [[V7]] : (i32);
    // CHECK-NEXT: } : (i32) -> (i32);
    // CHECK-NEXT: builtin.ret [[V4]] : (i32);
    // CHECK-NEXT: };
    builtin.function public extern("C") @two_cases(%s: i32, %x: i32) -> i32 {
        %r = scf.index_switch %s
        case 0 {
            builtin.ret %x : (i32);
        }
        case 1 {
            builtin.tail_call @g(%x) : extern("C") (i32) -> i32;
        }
        default {
            scf.yield %x : (i32);
        } : (i32);
        builtin.ret %r : (i32);
    };
    builtin.function public extern("C") @g(i32) -> i32;

    // A switch in a loop, one of whose cases breaks out of the loop: the break crosses the
    // switch's blocks, the `wasm.if` of the condition and the loop, to the loop's block.
    // CHECK-LABEL: @in_loop(
    // CHECK-SAME: [[V0:%[0-9]+]]: i32) -> i32 {
    // CHECK-NEXT: [[V1:%[0-9]+]] = wasm.const 0 : i32;
    // CHECK-NEXT: [[V2:%[0-9]+]] = wasm.const 1 : i32;
    // CHECK-NEXT: [[V3:%[0-9]+]] = wasm.block {
    // CHECK-NEXT: [[V4:%[0-9]+]] = wasm.loop [[V1]] {
    // CHECK-NEXT: ^{{block[0-9]+}}([[V5:%[0-9]+]]: i32):
    // CHECK-NEXT: [[V6:%[0-9]+]] = wasm.lt_u [[V5]], [[V0]];
    // CHECK-NEXT: wasm.if [[V6]] then {
    // CHECK-NEXT: [[V7:%[0-9]+]] = wasm.block {
    // CHECK-NEXT: wasm.block {
    // CHECK-NEXT: wasm.block {
    // CHECK-NEXT: wasm.block {
    // CHECK-NEXT: wasm.block {
    // CHECK-NEXT: [[V8:%[0-9]+]] = wasm.const 3 : i32;
    // CHECK-NEXT: [[V9:%[0-9]+]] = wasm.sub [[V5]], [[V8]];
    // CHECK-NEXT: wasm.br_table [[V9]] [{
    // CHECK-NEXT: wasm.br 0 : ();
    // CHECK-NEXT: }, {
    // CHECK-NEXT: wasm.br 1 : ();
    // CHECK-NEXT: }, {
    // CHECK-NEXT: wasm.br 2 : ();
    // CHECK-NEXT: }] default {
    // CHECK-NEXT: wasm.br 3 : ();
    // CHECK-NEXT: } : (i32);
    // CHECK-NEXT: } : () -> ();
    // CHECK-NEXT: wasm.br 6 [[V5]] : (i32);
    // CHECK-NEXT: } : () -> ();
    // CHECK-NEXT: [[V10:%[0-9]+]] = wasm.const 2 : i32;
    // CHECK-NEXT: [[V11:%[0-9]+]] = wasm.add [[V5]], [[V10]];
    // CHECK-NEXT: wasm.br 2 [[V11]] : (i32);
    // CHECK-NEXT: } : () -> ();
    // CHECK-NEXT: wasm.br 1 [[V5]] : (i32);
    // CHECK-NEXT: } : () -> ();
    // CHECK-NEXT: [[V12:%[0-9]+]] = wasm.add [[V5]], [[V2]];
    // CHECK-NEXT: wasm.end [[V12]] : (i32);
    // CHECK-NEXT: } : () -> (i32);
    // CHECK-NEXT: wasm.br 1 [[V7]] : (i32);
    // CHECK-NEXT: } : (i32) -> ();
    // CHECK-NEXT: wasm.end [[V5]] : (i32);
    // CHECK-NEXT: } : (i32) -> (i32);
    // CHECK-NEXT: wasm.end [[V4]] : (i32);
    // CHECK-NEXT: } : () -> (i32);
    // CHECK-NEXT: builtin.ret [[V3]] : (i32);
    // CHECK-NEXT: };
    builtin.function public extern("wasm") @in_loop(%n: i32) -> i32 {
        %zero = arith.constant 0 : i32;
        %one = arith.constant 1 : i32;
        %r = scf.while %zero before {
        ^b(%i: i32):
            %more = arith.cmpi ult %i, %n;
            scf.condition %more, %i : (i1, i32);
        } after {
        ^a(%j: i32):
            %next = scf.index_switch %j
            case 3 {
                scf.break 1 %j : (i32);
            }
            case 4 {
                %two = arith.constant 2 : i32;
                %k = arith.add %j, %two <{ overflow = #builtin.overflow<wrapping> }>;
                scf.yield %k : (i32);
            }
            case 5 {
                scf.yield %j : (i32);
            }
            default {
                %k = arith.add %j, %one <{ overflow = #builtin.overflow<wrapping> }>;
                scf.yield %k : (i32);
            } : (i32);
            scf.yield %next : (i32);
        } : (i32) -> (i32);
        builtin.ret %r : (i32);
    };
};
