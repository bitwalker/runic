// RUN: not runic-opt %s --target stackvm-unknown-unknown 2>&1 | filecheck %s --check-prefix=AMBIGUOUS
// RUN: runic-opt %s --target stackvm-unknown-unknown --backend altvm | filecheck %s --check-prefix=ALT
// RUN: runic-opt %s --target stackvm-unknown-unknown --backend stackvm | filecheck %s --check-prefix=STACK

// Two backends support the triple `stackvm-unknown-unknown`: without `--backend` the error names
// both and the flag that settles it, and prints nothing else. With it the named backend generates
// the code.

// AMBIGUOUS: error: more than one backend supports the target 'stackvm-unknown-unknown': choose one with --backend; the candidates are 'stackvm', 'altvm'
// AMBIGUOUS-NOT: {{::}}
// ALT: {{.*}}::k/1
// STACK: {{.*}}::k:
// STACK-NEXT: load 0
// STACK-NEXT: ret
fn k(x) = x;
