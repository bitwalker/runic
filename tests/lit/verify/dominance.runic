// RUN: runic-opt %s --split-input-file --verify-diagnostics

// The definition of every operand dominates its use. Each kind of definition that does not is a
// case: an operation that holds the use in one of its regions defines it, it is defined later in
// the same block, or in a block that does not dominate the use's. (An operation that reads its
// own result is refused by a rule of its own, in `verify/structure.runic`.) The message is the same for every placement; the expectations of those
// cases name the label that says where the definition is. An operand that reads a value printed
// later is written in the generic form (or in a custom form that states its operand types, as
// `scf.yield` and `cf.br` do). In a block of a function, a value of a nested or sibling region
// cannot be read in text (the parser knows no such name there); in a graph region it can, and
// `verify/dominance-nested-regions.runic` holds those cases.

// Uses that are dominated: a value of an enclosing region, a block argument, a value of a block
// that dominates the use's; a use in a block that cannot be reached is not checked, nor one in a
// graph region (a module's body), where every definition dominates every use.
builtin.module public @valid {
    test.sink %defined_after : (i32);
    %defined_after = arith.constant 1 : i32;
    builtin.function public extern("C") @f(%c: i1, %a: i32) -> i32 {
        %sum = arith.add %a, %a;
        %r = scf.if %c then {
            scf.yield %sum : (i32);
        } else {
            scf.yield %a : (i32);
        } : (i1) -> (i32);
        cf.br ^next(%r : i32);
    ^next(%n: i32):
        builtin.ret %n : (i32);
    ^dead:
        builtin.ret %later : (i32);
    ^unreached:
        %later = arith.add %a, %a;
        builtin.ret %later : (i32);
    };
};

// -----

// An operation that holds the use in one of its regions defines the value.
builtin.function public extern("C") @enclosing_result(%c: i1, %a: i32) -> i32 {
    %r = scf.if %c then {
        scf.yield %r : (i32); // expected-error {{it is defined here by 'scf.if', which holds the use in one of its regions}}
    } else {
        scf.yield %a : (i32);
    } : (i1) -> (i32);
    builtin.ret %r : (i32);
};

// -----

// The value is defined later in the same block.
builtin.function public extern("C") @later_in_block(%a: i32) -> i32 {
    // expected-error@+1 {{it is defined here, later in the same block}}
    %b = "arith.add"(%later, %a) : (i32, i32) -> i32;
    %later = arith.add %a, %a;
    builtin.ret %b : (i32);
};

// -----

// The value is defined in a block that does not dominate the use's: only one of the two ways into
// `^join` passes through `^yes`.
builtin.function public extern("C") @other_block(%c: i1, %a: i32) -> i32 {
    cf.cond_br %c ^yes, ^no : (i1);
^yes:
    %y = arith.add %a, %a;
    cf.br ^join;
^no:
    cf.br ^join;
^join:
    builtin.ret %y : (i32); // expected-error {{it is defined here, in a block that does not dominate the use}}
};

// -----

// A successor operand is an operand too.
builtin.function public extern("C") @successor_operand(%c: i1, %a: i32) -> i32 {
    cf.cond_br %c ^yes, ^no : (i1);
^yes:
    %y = arith.add %a, %a;
    cf.br ^join(%a : i32);
^no:
    cf.br ^join(%y : i32); // expected-error {{operand #0 of 'cf.br' is not dominated by its definition}}
^join(%j: i32):
    builtin.ret %j : (i32);
};
