// RUN: runic-opt %s --split-input-file --verify-diagnostics

// The rules of `builtin.function`: each effect it declares names an argument or result it has; a
// declaration states no locals; the entry block has one argument per parameter, of its type;
// every return in the body returns the function's result types, and none in a function that never
// returns; every local an operation of the body names is one of the function's, of its type. The
// signature's own rules are in `attributes.runic`. The entry block's arguments are written in the
// generic form, where they are not the parameters.

builtin.module public @valid {
    builtin.function public extern("C") @declared(ptr<i8>) -> ptr<i8> effects(read(arg 0), allocate(result 0));
    builtin.function public extern("C") @never() -> never;
    builtin.function public extern("C") @f(%a: i32) -> i32 locals(i32) {
        builtin.store_local 0, %a;
        %l = builtin.load_local 0 : i32;
        test.touch_local <{ local = #builtin.local_variable<0, i32> }>;
        builtin.ret %l : (i32);
    };
    builtin.function public extern("C") @imm() -> i8 {
        builtin.ret_imm 1 : i8;
    };
};

// -----

builtin.module public @m {
    builtin.function public extern("C") @effect_argument(ptr<i8>) effects(read(arg 3)); // expected-error {{the declared effect `read(arg 3)` names argument 3, but the function has 1 parameter(s)}}
};

// -----

builtin.module public @m {
    builtin.function public extern("C") @effect_result() -> i32 effects(write(result 1)); // expected-error {{the declared effect `write(result 1)` names result 1, but the function has 1 result(s)}}
};

// -----

builtin.module public @m {
    builtin.function public extern("C") @declaration_locals(i32) locals(i32); // expected-error {{a declaration has no body, so it has no locals, but this one states 1 local(s)}}
};

// -----

"builtin.function"() <{ name = #builtin.ident<@entry_count>, linkage = #builtin.visibility<public>, signature = #builtin.signature<extern("C") (i32) -> i32>, memory_effects = #builtin.declared_effects<unknown>, locals = #builtin.type_array<> }> ({ // expected-error {{expected one entry block argument per parameter; parameter count: 1, entry block argument count: 0}}
^entry:
    "builtin.ret_imm"() <{ value = #builtin.int<1 : i32> }> : () -> ();
}) : () -> ();

// -----

"builtin.function"() <{ name = #builtin.ident<@entry_type>, linkage = #builtin.visibility<public>, signature = #builtin.signature<extern("C") (i32) -> i32>, memory_effects = #builtin.declared_effects<unknown>, locals = #builtin.type_array<> }> ({ // expected-error {{argument 0 of the entry block has type `i64`, but parameter 0 has type `i32`}}
^entry(%a: i64):
    "builtin.ret_imm"() <{ value = #builtin.int<1 : i32> }> : () -> ();
}) : () -> ();

// -----

builtin.function public extern("C") @ret_types(%a: i32) -> i32 {
    builtin.ret; // expected-error {{this returns (), but the function returns (i32)}}
};

// -----

// The rule holds for `builtin.ret_imm` too.
builtin.function public extern("C") @ret_imm_type() -> i32 {
    builtin.ret_imm 1 : i64; // expected-error {{this returns (i64), but the function returns (i32)}}
};

// -----

builtin.function public extern("C") @returns_from_never(%a: i32) -> never {
    builtin.ret %a : (i32); // expected-error {{this returns from a function that never returns}}
};

// -----

// A local that is not one of the function's: its index.
builtin.function public extern("C") @local_index() locals(i32) {
    test.touch_local <{ local = #builtin.local_variable<1, i32> }>; // expected-error {{this names local 1, but the function has 1 local(s)}}
    builtin.ret;
};

// -----

// Its type. The rule is the same for `builtin.load_local` and `builtin.store_local`.
builtin.function public extern("C") @local_type() locals(i32) {
    test.touch_local <{ local = #builtin.local_variable<0, i64> }>; // expected-error {{this states that local 0 has type `i64`, but the function gives it type `i32`}}
    builtin.ret;
};
