// RUN: runic-opt %s --split-input-file --verify-diagnostics

// `builtin.yield`: the end of a region whose value its parent takes. The initializer of a global
// variable ends with it, and the type of the yielded value is the declared type of the global. A
// function is left with `builtin.ret` and a structured operation with its own terminator, so a
// yield is rejected under either. An operation takes the value of its region only if it says so
// (it carries `RegionYieldsValue`: a global variable and `wasm.global` do), so a yield is rejected
// under every other operation: a module, a component, a world, a `wasm.block` and the holder of
// the test dialect.

builtin.module public @valid {
    builtin.global_variable public @data : array<i8; 2> {
        %b = builtin.bytes "0a0b" : array<i8; 2>;
        builtin.yield %b;
    };
    builtin.global_variable public @declaration : i32;
};

// -----

builtin.module public @wrong_type {
    builtin.global_variable public @g : i32 { // expected-error {{the initializer of `@g` yields a value of type `array<i8; 2>`, but the global is declared `i32`}}
        %b = builtin.bytes "0a0b" : array<i8; 2>;
        builtin.yield %b;
    };
};

// -----

builtin.module public @another_terminator {
    builtin.global_variable public @g : i32 { // expected-error {{the initializer of `@g` ends with `ub.unreachable`, but an initializer ends with `builtin.yield`, which gives the value of the global}}
        ub.unreachable;
    };
};

// -----

builtin.module public @no_terminator {
    builtin.global_variable public @g : array<i8; 2> { // expected-error {{the initializer of `@g` ends with `builtin.bytes`, but an initializer ends with `builtin.yield`, which gives the value of the global}}
        %b = builtin.bytes "0a0b" : array<i8; 2>;
    };
};

// -----

builtin.module public @in_a_function {
    builtin.function public extern("C") @f(%a: i32) -> i32 {
        builtin.yield %a; // expected-error {{`builtin.function` is a function, which is left with `builtin.ret`, not with `builtin.yield`}}
    };
};

// -----

builtin.module public @in_a_structured_operation {
    builtin.function public extern("C") @f(%c: i1, %a: i32) {
        scf.if %c then {
            builtin.yield %a; // expected-error {{`scf.if` is a structured operation, which is left with its own terminator, not with `builtin.yield`}}
        } else {
            scf.yield : ();
        } : (i1) -> ();
        builtin.ret;
    };
};

// -----

builtin.module public @in_a_module {
    %a = arith.constant 1 : i32;
    builtin.yield %a; // expected-error {{`builtin.module` does not take a yielded value: `builtin.yield` ends the initializer of a global}}
};

// -----

builtin.component public @acme::@in_a_component {
    %a = arith.constant 1 : i32;
    builtin.yield %a; // expected-error {{`builtin.component` does not take a yielded value: `builtin.yield` ends the initializer of a global}}
};

// -----

builtin.world {
    builtin.component public @acme::@in_a_world { };
    %a = arith.constant 1 : i32;
    builtin.yield %a; // expected-error {{`builtin.world` does not take a yielded value: `builtin.yield` ends the initializer of a global}}
};

// -----

builtin.function public extern("C") @in_a_wasm_block(%a: i32) -> i32 {
    %r = wasm.block {
        builtin.yield %a; // expected-error {{`wasm.block` is a structured operation, which is left with its own terminator, not with `builtin.yield`}}
    } : () -> (i32);
    builtin.ret %r : (i32);
};

// -----

builtin.function public extern("C") @in_a_holder(%a: i32) -> i32 {
    "test.reads_locals_and_holds"() ({
        builtin.yield %a; // expected-error {{`test.reads_locals_and_holds` does not take a yielded value: `builtin.yield` ends the initializer of a global}}
    }) : () -> ();
    builtin.ret %a : (i32);
};
