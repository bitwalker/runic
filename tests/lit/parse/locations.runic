// RUN: runic-opt %s --print-locations | filecheck %s
// RUN: runic-opt %s --print-locations --verify-roundtrip | filecheck %s

// The source location of each operation and block argument, printed with `--print-locations`: the
// file as given, and the line and column where the operation or the argument starts and ends. The
// input is read from `%s`, so the locations name this file (a location that names standard input
// could not be resolved by a second run). The path is matched with `{{.*}}`, since it is the path
// as given. The second RUN line also checks that both forms, with their locations, read back.

// CHECK-LABEL: @entrypoint(
// CHECK-SAME: {{%[0-9]+}}: i32 loc("{{.*}}locations.runic":[[@LINE+3]]:50 to [[@LINE+3]]:51)) -> i32 {
// CHECK-NEXT: builtin.ret {{%[0-9]+}} : (i32) loc("{{.*}}locations.runic":[[@LINE+3]]:5 to [[@LINE+3]]:16);
// CHECK-NEXT: } loc("{{.*}}locations.runic":[[@LINE+1]]:1 to [[@LINE+1]]:17);
builtin.function public extern("C") @entrypoint(%a: i32) -> i32 {
    builtin.ret %a : (i32);
};
