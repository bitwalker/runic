// RUN: runic-opt %s | filecheck %s
// RUN: runic-opt %s --verify-roundtrip | filecheck %s
// RUN: runic-opt %s --print-generic | runic-opt - --verify-roundtrip

// Every operation of the `test` dialect that runic-opt registers, read and printed in its custom
// form; the last RUN line reads the generic form of each back. `test.reads_locals_and_holds` has
// no custom form and is written and printed in the generic form. Where the parser takes more than
// the printer writes, the input uses the other spelling: a property at its default, `true` for
// `#builtin.bool<true>`, a hexadecimal constant.
// CHECK: builtin.module public @test {
builtin.module public @test {
    // An attribute dictionary on each derived form that has none elsewhere in this file.
    // CHECK-LABEL: builtin.function public extern("C") @dictionaries(
    // CHECK-SAME: [[A:%[0-9]+]]: i32, [[W:%[0-9]+]]: i128, [[P:%[0-9]+]]: ptr<i32>, [[S:%[0-9]+]]: i8) -> i32 locals(i32) {
    // CHECK-NEXT: [[SUM:%[0-9]+]] = test.add [[A]], [[A]] attributes { note = #builtin.i32<10> };
    // CHECK-NEXT: [[EQ:%[0-9]+]] = test.eq [[A]], [[A]] attributes { note = #builtin.i32<11> };
    // CHECK-NEXT: [[NE:%[0-9]+]] = test.neq [[A]], [[A]] attributes { note = #builtin.i32<12> };
    // CHECK-NEXT: [[PRODUCT:%[0-9]+]] = test.mul [[A]], [[A]] attributes { note = #builtin.i32<13> };
    // CHECK-NEXT: [[EFFECTS:%[0-9]+]] = test.effects <{ known = #builtin.bool<true> }> attributes { note = #builtin.i32<14> };
    // CHECK-NEXT: [[LOW:%[0-9]+]] = test.low [[W]] attributes { note = #builtin.i32<15> };
    // CHECK-NEXT: [[HIGH:%[0-9]+]] = test.high [[W]] attributes { note = #builtin.i32<16> };
    // CHECK-NEXT: [[JOINED:%[0-9]+]] = test.join [[LOW]], [[HIGH]] attributes { note = #builtin.i32<17> };
    // CHECK-NEXT: test.sink [[JOINED]] attributes { note = #builtin.i32<18> } : (i128);
    // CHECK-NEXT: test.store [[P]], [[A]] attributes { note = #builtin.i32<19> } : (ptr<i32>, i32);
    // CHECK-NEXT: [[LOADED:%[0-9]+]] = test.load [[P]] attributes { note = #builtin.i32<20> };
    // CHECK-NEXT: test.touch_local <{ local = #builtin.local_variable<0, i32> }> attributes { note = #builtin.i32<21> };
    // CHECK-NEXT: [[CHECKED:%[0-9]+]] = test.check_range [[S]] <{ umin = #builtin.int<1 : i8>, umax = #builtin.int<-56 : i8> }> attributes { note = #builtin.i32<22> };
    // CHECK-NEXT: test.ret [[SUM]] attributes { note = #builtin.i32<23> } : (i32);
    // CHECK-NEXT: };
    builtin.function public extern("C") @dictionaries(%a: i32, %w: i128, %p: ptr<i32>, %s: i8) -> i32 locals(i32) {
        %sum = test.add %a, %a <{ overflow = #builtin.overflow<wrapping> }> attributes { note = #builtin.i32<10> };
        %eq = test.eq %a, %a attributes { note = #builtin.i32<11> };
        %ne = test.neq %a, %a attributes { note = #builtin.i32<12> };
        %product = test.mul %a, %a attributes { note = #builtin.i32<13> };
        %effects = test.effects <{ known = true }> attributes { note = #builtin.i32<14> };
        %low = test.low %w attributes { note = #builtin.i32<15> };
        %high = test.high %w attributes { note = #builtin.i32<16> };
        %joined = test.join %low, %high attributes { note = #builtin.i32<17> };
        test.sink %joined attributes { note = #builtin.i32<18> } : (i128);
        test.store %p, %a attributes { note = #builtin.i32<19> } : (ptr<i32>, i32);
        %loaded = test.load %p attributes { note = #builtin.i32<20> };
        test.touch_local <{ local = #builtin.local_variable<0, i32> }> attributes { note = #builtin.i32<21> };
        %checked = test.check_range %s <{ umin = #builtin.int<1 : i8>, umax = #builtin.int<-56 : i8> }> attributes { note = #builtin.i32<22> };
        test.ret %sum attributes { note = #builtin.i32<23> } : (i32);
    };

    // CHECK-LABEL: builtin.function public extern("C") @callee(
    // CHECK-SAME: i32) -> i32;
    builtin.function public extern("C") @callee(i32) -> i32;
    // CHECK-LABEL: builtin.function public extern("C") @other(
    // CHECK-SAME: i32) -> i32;
    builtin.function public extern("C") @other(i32) -> i32;

    // Arithmetic, comparisons, effects, a call of one of two callees, and the conversions between
    // an `i128` and its halves.
    // CHECK-LABEL: builtin.function public extern("C") @values(
    // CHECK-SAME: [[A:%[0-9]+]]: i32, [[W:%[0-9]+]]: i128) -> i32 {
    // CHECK-NEXT: [[SEVEN:%[0-9]+]] = test.constant 7 : i32;
    // CHECK-NEXT: [[HEX:%[0-9]+]] = test.constant 16 : i8 attributes { note = #builtin.i32<1> };
    // CHECK-NEXT: [[SUM:%[0-9]+]] = test.add [[A]], [[SEVEN]];
    // CHECK-NEXT: [[WRAPPING:%[0-9]+]] = test.add [[A]], [[SEVEN]];
    // CHECK-NEXT: [[CHECKED:%[0-9]+]] = test.add [[A]], [[SEVEN]] <{ overflow = #builtin.overflow<checked unsigned> }>;
    // CHECK-NEXT: [[PRODUCT:%[0-9]+]] = test.mul [[SUM]], [[A]] <{ overflow = #builtin.overflow<unchecked signed> }>;
    // CHECK-NEXT: [[SHIFTED:%[0-9]+]] = test.shl [[PRODUCT]], [[A]] attributes { note = #builtin.i32<2> };
    // CHECK-NEXT: [[EQ:%[0-9]+]] = test.eq [[SHIFTED]], [[A]];
    // CHECK-NEXT: [[NE:%[0-9]+]] = test.neq [[SHIFTED]], [[A]];
    // CHECK-NEXT: [[UNKNOWN:%[0-9]+]] = test.effects <{ known = #builtin.bool<false> }>;
    // CHECK-NEXT: [[KNOWN:%[0-9]+]] = test.effects <{ known = #builtin.bool<true> }>;
    // CHECK-NEXT: [[CALLED:%[0-9]+]] = test.call_one_of [[A]], @callee, @other([[SHIFTED]]) : extern("C") (i32) -> i32;
    // CHECK-NEXT: [[NOTED:%[0-9]+]] = test.call_one_of [[A]], @callee, @other([[SHIFTED]]) : extern("C") (i32) -> i32 attributes { note = #builtin.i32<3> };
    // CHECK-NEXT: [[LOW:%[0-9]+]] = test.low [[W]];
    // CHECK-NEXT: [[HIGH:%[0-9]+]] = test.high [[W]];
    // CHECK-NEXT: [[JOINED:%[0-9]+]] = test.join [[LOW]], [[HIGH]];
    // CHECK-NEXT: test.sink [[JOINED]] : (i128);
    // CHECK-NEXT: test.sink [[JOINED]], [[A]], [[CALLED]] : (i128, i32, i32);
    // CHECK-NEXT: builtin.ret [[CALLED]] : (i32);
    // CHECK-NEXT: };
    builtin.function public extern("C") @values(%a: i32, %w: i128) -> i32 {
        %seven = test.constant 7 : i32;
        %hex = test.constant 0x10 : i8 attributes { note = #builtin.i32<1> };
        %sum = test.add %a, %seven;
        %wrapping = test.add %a, %seven <{ overflow = #builtin.overflow<wrapping> }>;
        %checked = test.add %a, %seven <{ overflow = #builtin.overflow<checked unsigned> }>;
        %product = test.mul %sum, %a <{ overflow = #builtin.overflow<unchecked signed> }>;
        %shifted = test.shl %product, %a attributes { note = #builtin.i32<2> };
        %eq = test.eq %shifted, %a;
        %ne = test.neq %shifted, %a;
        %unknown = test.effects <{ known = #builtin.bool<false> }>;
        %known = test.effects <{ known = true }>;
        %called = test.call_one_of %a, @callee, @other(%shifted) : extern("C") (i32) -> i32;
        %noted = test.call_one_of %a, @callee, @other(%shifted) : extern("C") (i32) -> i32 attributes { note = #builtin.i32<3> };
        %low = test.low %w;
        %high = test.high %w;
        %joined = test.join %low, %high;
        test.sink %joined : (i128);
        test.sink %joined, %a, %called : (i128, i32, i32);
        builtin.ret %called : (i32);
    };

    // Memory: a store, a load, a local touched, an operation that reads the locals and holds a
    // region, and a range check.
    // CHECK-LABEL: builtin.function public extern("C") @memory(
    // CHECK-SAME: [[P:%[0-9]+]]: ptr<i32>, [[V:%[0-9]+]]: i32, [[S:%[0-9]+]]: i8) -> i32 locals(i32) {
    // CHECK-NEXT: test.store [[P]], [[V]] : (ptr<i32>, i32);
    // CHECK-NEXT: [[LOADED:%[0-9]+]] = test.load [[P]];
    // CHECK-NEXT: test.touch_local <{ local = #builtin.local_variable<0, i32> }>;
    // CHECK-NEXT: "test.reads_locals_and_holds"() ({ }) : () -> ();
    // CHECK-NEXT: [[CHECKED:%[0-9]+]] = test.check_range [[S]] <{ umin = #builtin.int<1 : i8>, umax = #builtin.int<-56 : i8> }>;
    // CHECK-NEXT: builtin.ret [[LOADED]] : (i32);
    // CHECK-NEXT: };
    builtin.function public extern("C") @memory(%p: ptr<i32>, %v: i32, %s: i8) -> i32 locals(i32) {
        test.store %p, %v : (ptr<i32>, i32);
        %loaded = test.load %p;
        test.touch_local <{ local = #builtin.local_variable<0, i32> }>;
        "test.reads_locals_and_holds"() ({ }) : () -> ();
        %checked = test.check_range %s <{ umin = #builtin.int<1 : i8>, umax = #builtin.int<-56 : i8> }>;
        builtin.ret %loaded : (i32);
    };

    // `test.ret` of nothing and of values.
    // CHECK-LABEL: builtin.function public extern("C") @never(
    // CHECK-SAME: [[X:%[0-9]+]]: i32) -> never {
    // CHECK-NEXT: test.ret : ();
    // CHECK-NEXT: };
    builtin.function public extern("C") @never(%x: i32) -> never {
        test.ret : ();
    };
    // CHECK-LABEL: builtin.function public extern("C") @values_out(
    // CHECK-SAME: [[X:%[0-9]+]]: i32) -> (i32, i32) {
    // CHECK-NEXT: test.ret [[X]], [[X]] : (i32, i32);
    // CHECK-NEXT: };
    // CHECK-NEXT: };
    builtin.function public extern("C") @values_out(%x: i32) -> (i32, i32) {
        test.ret %x, %x : (i32, i32);
    };
};
