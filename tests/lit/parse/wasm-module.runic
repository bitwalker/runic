// RUN: runic-opt %s | filecheck %s
// RUN: runic-opt %s --verify-roundtrip | filecheck %s
// RUN: runic-opt %s --print-generic | runic-opt - --verify-roundtrip

// The module-level operations of `wasm`, one of each kind, as definitions, as imports (a
// `declaration`, which has no body) and with exports. A memory and a table have limits (`MIN` or
// `MIN..MAX`); a global has an optional `mut` before its type and, as a definition, a region of
// constant instructions with no terminator; an element segment names its table, an `i32` offset
// and the functions; a tag has parameter types. The dictionary entries `wasm.import_module` and
// `wasm.export_name` mark imports and exports. The last RUN line reads the generic form of each
// back.
// CHECK: builtin.module public @wasm_module {
builtin.module public @wasm_module {
    // CHECK-NEXT: wasm.memory public @mem : 1..16 attributes { wasm.export_name = #builtin.string<"memory"> };
    // CHECK-NEXT: wasm.memory public declaration @shared : 2 attributes { wasm.import_module = #builtin.string<"host"> };
    // CHECK-NEXT: wasm.memory private @unbounded : 0;
    wasm.memory public @mem : 1..16 attributes { wasm.export_name = "memory" };
    wasm.memory public declaration @shared : 2 attributes { wasm.import_module = "host" };
    wasm.memory private @unbounded : 0;

    // CHECK-NEXT: wasm.table private @tab : 0..8 x !wasm.funcref attributes { wasm.export_name = [#builtin.string<"table">, #builtin.string<"t">] };
    // CHECK-NEXT: wasm.table private declaration @refs : 4 x !wasm.externref;
    wasm.table private @tab : 0..8 x !wasm.funcref attributes { wasm.export_name = ["table", "t"] };
    wasm.table private declaration @refs : 4 x !wasm.externref;

    // A mutable global with one constant, a constant global computed from three, and an import.
    // CHECK-NEXT: wasm.global private @sp : mut i32 {
    // CHECK-NEXT: {{%[0-9]+}} = wasm.const 65536 : i32;
    // CHECK-NEXT: } attributes { wasm.export_name = #builtin.string<"stack_pointer"> };
    wasm.global private @sp : mut i32 {
        %v = wasm.const 65536 : i32;
    } attributes { wasm.export_name = "stack_pointer" };
    // CHECK-NEXT: wasm.global private @size : i64 {
    // CHECK-NEXT: {{%[0-9]+}} = wasm.const 8 : i64;
    // CHECK-NEXT: {{%[0-9]+}} = wasm.const 4 : i64;
    // CHECK-NEXT: {{%[0-9]+}} = wasm.mul {{%[0-9]+}}, {{%[0-9]+}};
    // CHECK-NEXT: };
    wasm.global private @size : i64 {
        %a = wasm.const 8 : i64;
        %b = wasm.const 4 : i64;
        %c = wasm.mul %a, %b;
    };
    // CHECK-NEXT: wasm.global private @pi : f64 {
    // CHECK-NEXT: {{%[0-9]+}} = wasm.constf 3.14 : f64;
    // CHECK-NEXT: };
    wasm.global private @pi : f64 {
        %v = wasm.constf 3.14 : f64;
    };
    // CHECK-NEXT: wasm.global private @counter : mut i32 attributes { link_name = #builtin.string<"counter">, wasm.import_module = #builtin.string<"env"> };
    wasm.global private @counter : mut i32 attributes { link_name = "counter", wasm.import_module = "env" };

    // CHECK-NEXT: wasm.tag private @exn : (i32, i64);
    // CHECK-NEXT: wasm.tag private declaration @none : ();
    wasm.tag private @exn : (i32, i64);
    wasm.tag private declaration @none : ();

    // CHECK-NEXT: builtin.function public extern("C") @f()
    // CHECK-NEXT: builtin.function public extern("C") @g() {
    builtin.function public extern("C") @f() attributes { wasm.import_module = "other" };
    builtin.function public extern("C") @g() {
        builtin.ret;
    } attributes { wasm.export_name = "g" };

    // An element segment: the offset is read as `wasm.const` reads an `i32` (hexadecimal too).
    // CHECK: wasm.elem private @init : @tab at 0 [@f, @g];
    // CHECK-NEXT: wasm.elem private @more : @tab at 4 [@g];
    // CHECK-NEXT: wasm.elem private @none_at_all : @tab at 7 [];
    wasm.elem private @init : @tab at 0 [@f, @g];
    wasm.elem private @more : @tab at 0x4 [@g];
    wasm.elem private @none_at_all : @tab at 7 [];

    // Everything the custom form accepts, also in the generic form (a global's region is empty for
    // an import)
    "wasm.memory"() <{ name = #builtin.ident<@generic>, visibility = #builtin.visibility<private>, limits = #wasm.limits<3..4>, declaration = #builtin.bool<false> }> : () -> ();
    "wasm.global"() <{ name = #builtin.ident<@generic_global>, visibility = #builtin.visibility<private>, ty = #builtin.type<i32>, mutability = #wasm.mutability<const> }> ({
        %v = "wasm.const"() <{ value = #builtin.int<1 : i32> }> : () -> i32;
    }) : () -> ();
};
