// RUN: runic-opt %s | filecheck %s
// RUN: runic-opt %s --verify-roundtrip | filecheck %s

// The structured control flow dialect on a larger example, read and printed: `scf.while` loops
// nested in `scf.if`, an `scf.index_switch`, operations with many results, and a function body
// that branches to blocks after the loops. The reprint is the input.

// CHECK-LABEL: builtin.function public extern("C") @scf(
// CHECK-SAME: [[BASE:%[0-9]+]]: ptr<i32>, [[N:%[0-9]+]]: i32, [[M:%[0-9]+]]: i32) -> i32 {
// CHECK-NEXT: [[TWO:%[0-9]+]] = arith.constant 2 : i32;
// CHECK-NEXT: [[POISON:%[0-9]+]] = ub.poison <{ value = #ub.poison<i32> }>;
// CHECK-NEXT: [[ONE:%[0-9]+]] = arith.constant 1 : i32;
// CHECK-NEXT: [[ZERO:%[0-9]+]] = arith.constant 0 : i32;
// CHECK-NEXT: [[R0:%[0-9]+]], [[R1:%[0-9]+]], [[R2:%[0-9]+]], [[R3:%[0-9]+]] = scf.while [[ZERO]], [[ZERO]] before {
// CHECK-NEXT: ^[[B_OUTER_HEAD:block[0-9]+]]([[I:%[0-9]+]]: i32, [[ACC:%[0-9]+]]: i32):
// CHECK-NEXT: [[IN_RANGE:%[0-9]+]] = arith.cmpi ult [[I]], [[N]];
// CHECK-NEXT: [[A0:%[0-9]+]], [[A1:%[0-9]+]], [[A2:%[0-9]+]], [[A3:%[0-9]+]] = scf.if [[IN_RANGE]] then {
// CHECK-NEXT: [[ROW:%[0-9]+]] = arith.mul [[I]], [[M]] <{ overflow = #builtin.overflow<unchecked unsigned> }>;
// CHECK-NEXT: [[W0:%[0-9]+]], [[W1:%[0-9]+]], [[W2:%[0-9]+]], [[W3:%[0-9]+]], [[W4:%[0-9]+]], [[W5:%[0-9]+]], [[W6:%[0-9]+]] = scf.while [[ZERO]], [[ACC]] before {
// CHECK-NEXT: ^[[B_INNER_HEAD:block[0-9]+]]([[J:%[0-9]+]]: i32, [[SUM:%[0-9]+]]: i32):
// CHECK-NEXT: [[J_IN_RANGE:%[0-9]+]] = arith.cmpi ult [[J]], [[M]];
// CHECK-NEXT: [[B0:%[0-9]+]], [[B1:%[0-9]+]], [[B2:%[0-9]+]], [[B3:%[0-9]+]], [[B4:%[0-9]+]], [[B5:%[0-9]+]] = scf.if [[J_IN_RANGE]] then {
// CHECK-NEXT: [[IDX:%[0-9]+]] = arith.add [[ROW]], [[J]] <{ overflow = #builtin.overflow<unchecked unsigned> }>;
// CHECK-NEXT: [[ADDR:%[0-9]+]] = builtin.unrealized_conversion_cast [[BASE]] : ptr<i32> to i32;
// CHECK-NEXT: [[ELEM_ADDR:%[0-9]+]] = arith.add [[ADDR]], [[IDX]] <{ overflow = #builtin.overflow<unchecked unsigned> }>;
// CHECK-NEXT: [[ELEM_PTR:%[0-9]+]] = builtin.unrealized_conversion_cast [[ELEM_ADDR]] : i32 to ptr<i32>;
// CHECK-NEXT: [[ELEM:%[0-9]+]] = builtin.unrealized_conversion_cast [[ELEM_PTR]] : ptr<i32> to i32;
// CHECK-NEXT: [[NEXT_J:%[0-9]+]] = arith.add [[J]], [[ONE]];
// CHECK-NEXT: [[OVERFLOWED:%[0-9]+]], [[NEXT_SUM:%[0-9]+]] = arith.add_overflowing [[SUM]], [[ELEM]] <{ signedness = #builtin.signedness<unsigned> }>;
// CHECK-NEXT: [[C0:%[0-9]+]] = cf.select [[OVERFLOWED]], [[POISON]], [[NEXT_J]];
// CHECK-NEXT: [[C1:%[0-9]+]] = cf.select [[OVERFLOWED]], [[POISON]], [[NEXT_SUM]];
// CHECK-NEXT: [[C2:%[0-9]+]] = cf.select [[OVERFLOWED]], [[ONE]], [[POISON]];
// CHECK-NEXT: [[C3:%[0-9]+]] = cf.select [[OVERFLOWED]], [[ZERO]], [[POISON]];
// CHECK-NEXT: [[C4:%[0-9]+]] = cf.select [[OVERFLOWED]], [[ONE]], [[ZERO]];
// CHECK-NEXT: [[C5:%[0-9]+]] = cf.select [[OVERFLOWED]], [[ZERO]], [[ONE]];
// CHECK-NEXT: scf.yield [[C0]], [[C1]], [[C2]], [[C3]], [[C4]], [[C5]] : (i32, i32, i32, i32, i32, i32);
// CHECK-NEXT: } else {
// CHECK-NEXT: scf.yield [[POISON]], [[POISON]], [[POISON]], [[POISON]], [[TWO]], [[ZERO]] : (i32, i32, i32, i32, i32, i32);
// CHECK-NEXT: } : (i1) -> (i32, i32, i32, i32, i32, i32);
// CHECK-NEXT: [[AGAIN:%[0-9]+]] = arith.trunc [[B5]] <{ ty = #builtin.type<i1> }>;
// CHECK-NEXT: scf.condition [[AGAIN]], [[B0]], [[B1]], [[SUM]], [[POISON]], [[B2]], [[B3]], [[B4]] : (i1, i32, i32, i32, i32, i32, i32, i32);
// CHECK-NEXT: } after {
// CHECK-NEXT: ^[[B_INNER_BODY:block[0-9]+]]([[X0:%[0-9]+]]: i32, [[X1:%[0-9]+]]: i32, [[X2:%[0-9]+]]: i32, [[X3:%[0-9]+]]: i32, [[X4:%[0-9]+]]: i32, [[X5:%[0-9]+]]: i32, [[X6:%[0-9]+]]: i32):
// CHECK-NEXT: scf.yield [[X0]], [[X1]] : (i32, i32);
// CHECK-NEXT: } : (i32, i32) -> (i32, i32, i32, i32, i32, i32, i32);
// CHECK-NEXT: [[S0:%[0-9]+]], [[S1:%[0-9]+]], [[S2:%[0-9]+]], [[S3:%[0-9]+]] = scf.index_switch [[W6]]
// CHECK-NEXT: case 1 {
// CHECK-NEXT: scf.yield [[W3]], [[W3]], [[W4]], [[W5]] : (i32, i32, i32, i32);
// CHECK-NEXT: }
// CHECK-NEXT: default {
// CHECK-NEXT: [[NEXT_I:%[0-9]+]] = arith.add [[I]], [[ONE]];
// CHECK-NEXT: scf.yield [[NEXT_I]], [[W2]], [[ZERO]], [[ONE]] : (i32, i32, i32, i32);
// CHECK-NEXT: } : (i32, i32, i32, i32);
// CHECK-NEXT: scf.yield [[S0]], [[S1]], [[S2]], [[S3]] : (i32, i32, i32, i32);
// CHECK-NEXT: } else {
// CHECK-NEXT: scf.yield [[POISON]], [[POISON]], [[TWO]], [[ZERO]] : (i32, i32, i32, i32);
// CHECK-NEXT: } : (i1) -> (i32, i32, i32, i32);
// CHECK-NEXT: [[CONTINUE:%[0-9]+]] = arith.trunc [[A3]] <{ ty = #builtin.type<i1> }>;
// CHECK-NEXT: scf.condition [[CONTINUE]], [[A0]], [[A1]], [[ACC]], [[A2]] : (i1, i32, i32, i32, i32);
// CHECK-NEXT: } after {
// CHECK-NEXT: ^[[B_OUTER_BODY:block[0-9]+]]([[Y0:%[0-9]+]]: i32, [[Y1:%[0-9]+]]: i32, [[Y2:%[0-9]+]]: i32, [[Y3:%[0-9]+]]: i32):
// CHECK-NEXT: scf.yield [[Y0]], [[Y1]] : (i32, i32);
// CHECK-NEXT: } : (i32, i32) -> (i32, i32, i32, i32);
// CHECK-NEXT: [[FAILED:%[0-9]+]] = arith.cmpi eq [[R3]], [[ONE]];
// CHECK-NEXT: cf.cond_br [[FAILED]] ^[[B_TRAP:block[0-9]+]], ^[[B_DONE:block[0-9]+]] : (i1);
// CHECK-NEXT: ^[[B_DONE]]:
// CHECK-NEXT: builtin.ret [[R2]] : (i32);
// CHECK-NEXT: ^[[B_TRAP]]:
// CHECK-NEXT: builtin.ret_imm -1 : i32;
// CHECK-NEXT: };
builtin.function public extern("C") @scf(%base: ptr<i32>, %n: i32, %m: i32) -> i32 {
    %two = arith.constant 2 : i32;
    %poison = ub.poison <{ value = #ub.poison<i32> }>;
    %one = arith.constant 1 : i32;
    %zero = arith.constant 0 : i32;
    %r0, %r1, %r2, %r3 = scf.while %zero, %zero before {
    ^outer_head(%i: i32, %acc: i32):
        %in_range = arith.cmpi ult %i, %n;
        %a0, %a1, %a2, %a3 = scf.if %in_range then {
            %row = arith.mul %i, %m <{ overflow = #builtin.overflow<unchecked unsigned> }>;
            %w0, %w1, %w2, %w3, %w4, %w5, %w6 = scf.while %zero, %acc before {
            ^inner_head(%j: i32, %sum: i32):
                %j_in_range = arith.cmpi ult %j, %m;
                %b0, %b1, %b2, %b3, %b4, %b5 = scf.if %j_in_range then {
                    %idx = arith.add %row, %j <{ overflow = #builtin.overflow<unchecked unsigned> }>;
                    %addr = builtin.unrealized_conversion_cast %base : ptr<i32> to i32;
                    %elem_addr = arith.add %addr, %idx <{ overflow = #builtin.overflow<unchecked unsigned> }>;
                    %elem_ptr = builtin.unrealized_conversion_cast %elem_addr : i32 to ptr<i32>;
                    %elem = builtin.unrealized_conversion_cast %elem_ptr : ptr<i32> to i32;
                    %next_j = arith.add %j, %one;
                    %overflowed, %next_sum = arith.add_overflowing %sum, %elem <{ signedness = #builtin.signedness<unsigned> }>;
                    %c0 = cf.select %overflowed, %poison, %next_j;
                    %c1 = cf.select %overflowed, %poison, %next_sum;
                    %c2 = cf.select %overflowed, %one, %poison;
                    %c3 = cf.select %overflowed, %zero, %poison;
                    %c4 = cf.select %overflowed, %one, %zero;
                    %c5 = cf.select %overflowed, %zero, %one;
                    scf.yield %c0, %c1, %c2, %c3, %c4, %c5 : (i32, i32, i32, i32, i32, i32);
                } else {
                    scf.yield %poison, %poison, %poison, %poison, %two, %zero : (i32, i32, i32, i32, i32, i32);
                } : (i1) -> (i32, i32, i32, i32, i32, i32);
                %again = arith.trunc %b5 <{ ty = #builtin.type<i1> }>;
                scf.condition %again, %b0, %b1, %sum, %poison, %b2, %b3, %b4 : (i1, i32, i32, i32, i32, i32, i32, i32);
            } after {
            ^inner_body(%x0: i32, %x1: i32, %x2: i32, %x3: i32, %x4: i32, %x5: i32, %x6: i32):
                scf.yield %x0, %x1 : (i32, i32);
            } : (i32, i32) -> (i32, i32, i32, i32, i32, i32, i32);
            %s0, %s1, %s2, %s3 = scf.index_switch %w6
            case 1 {
                scf.yield %w3, %w3, %w4, %w5 : (i32, i32, i32, i32);
            }
            default {
                %next_i = arith.add %i, %one;
                scf.yield %next_i, %w2, %zero, %one : (i32, i32, i32, i32);
            } : (i32, i32, i32, i32);
            scf.yield %s0, %s1, %s2, %s3 : (i32, i32, i32, i32);
        } else {
            scf.yield %poison, %poison, %two, %zero : (i32, i32, i32, i32);
        } : (i1) -> (i32, i32, i32, i32);
        %continue = arith.trunc %a3 <{ ty = #builtin.type<i1> }>;
        scf.condition %continue, %a0, %a1, %acc, %a2 : (i1, i32, i32, i32, i32);
    } after {
    ^outer_body(%y0: i32, %y1: i32, %y2: i32, %y3: i32):
        scf.yield %y0, %y1 : (i32, i32);
    } : (i32, i32) -> (i32, i32, i32, i32);
    %failed = arith.cmpi eq %r3, %one;
    cf.cond_br %failed ^trap, ^done : (i1);
^done:
    builtin.ret %r2 : (i32);
^trap:
    builtin.ret_imm -1 : i32;
};
