// RUN: { for i in $(seq 1001); do printf '"test.reads_locals_and_holds"() ({ '; done; echo '// expected-error {{regions are nested more than 1000 deep}}'; } | runic-opt - --verify-diagnostics
// RUN: { for i in $(seq 1000); do printf '"test.reads_locals_and_holds"() ({ '; done; printf "// expected-error {{unexpected token 'end of input'}}"; } | runic-opt - --verify-diagnostics

// Regions nested more deeply than runic-opt reads them: the tool's limit is 1,000. The input is
// generated by the RUN lines, on one line: 1,001 operations, each opening a region in the one
// before, are an error at the 1,001st region, before the input ends; 1,000 are read, and the error
// is then the end of the input. The expectation is on the generated line. Lists nested too deeply
// are in `errors-attributes.runic`, types in `errors-types.runic`.
