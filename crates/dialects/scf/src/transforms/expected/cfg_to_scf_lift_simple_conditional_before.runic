builtin.function public extern("C") @cfg_to_scf_lift_simple_conditional(%0: i32) -> i32 {
    %2 = arith.constant 0 : i32;
    %3 = arith.cmpi eq %0, %2;
    cf.cond_br %3 ^block1, ^block2 : (i1);
^block1:
    %4 = arith.constant 1 : i32;
    %5 = arith.add %0, %4;
    cf.br ^block3(%5 : i32);
^block2:
    %6 = arith.mul %0, %0;
    cf.br ^block3(%6 : i32);
^block3(%1: i32):
    builtin.ret %1 : (i32);
};