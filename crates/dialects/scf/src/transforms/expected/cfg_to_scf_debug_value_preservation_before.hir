builtin.function public extern("C") @cfg_to_scf_debug_value_preservation(%0: i32) -> i32 {
    %2 = arith.constant 0 : i32;
    %3 = arith.cmpi eq %0, %2;
    di.debug_value %0 <{ variable = #di.variable<{ name = "input", file = "test.rs", line = 1, column = 1 }>, expression = #di.expression<[]> }> : (i32);
    cf.cond_br %3 ^block1, ^block2 : (i1);
^block1:
    %4 = arith.constant 1 : i32;
    %5 = arith.add %0, %4;
    di.debug_value %5 <{ variable = #di.variable<{ name = "result", file = "test.rs", line = 2, column = 1 }>, expression = #di.expression<[]> }> : (i32);
    cf.br ^block3(%5 : i32);
^block2:
    %6 = arith.mul %0, %0;
    di.debug_value %6 <{ variable = #di.variable<{ name = "result", file = "test.rs", line = 2, column = 1 }>, expression = #di.expression<[]> }> : (i32);
    cf.br ^block3(%6 : i32);
^block3(%1: i32):
    di.debug_value %1 <{ variable = #di.variable<{ name = "result", file = "test.rs", line = 2, column = 1 }>, expression = #di.expression<[]> }> : (i32);
    builtin.ret %1 : (i32);
};