builtin.function public extern("C") @index_switch_remove_unused_results(%0: i32) -> i32 {
    %2 = test.constant 2 : i32;
    %4 = test.constant 4 : i32;
    %7 = scf.index_switch %0
    case 1 {
        scf.yield %2 : (i32);
    }
    default {
        scf.yield %4 : (i32);
    } : (i32);
    builtin.ret %7 : (i32);
};
