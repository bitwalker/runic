builtin.function public extern("C") @fold_redundant_yields_effects_if(%0: i32, %1: ptr<i32>) -> i32 {
    %3 = test.constant 11 : i32;
    %4 = test.constant 0 : i32;
    %5 = test.eq %0, %4;
    %8 = scf.if %5 then {
        scf.yield %3 : (i32);
    } else {
        test.store %1, %3 : (ptr<i32>, i32);
        scf.yield %3 : (i32);
