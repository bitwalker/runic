builtin.function public extern("C") @fold_redundant_yields_different_pos_switch(%0: i32) -> i32 {
    %3 = test.constant 11 : i32;
    %4 = test.constant 22 : i32;
    %8, %9 = scf.index_switch %0 
    case 1 {
        scf.yield %3, %4 : (i32, i32);
    }
    case 2 {
        scf.yield %4, %3 : (i32, i32);
    }
    default {
        scf.yield %3, %4 : (i32, i32);
    } : (i32, i32);
    %5 = test.add %8, %9 <{ overflow = #builtin.overflow<checked unsigned> }>;
    builtin.ret %5 : (i32);
};