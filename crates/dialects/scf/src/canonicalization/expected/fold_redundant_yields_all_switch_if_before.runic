builtin.function public extern("C") @fold_redundant_yields_all_switch_if(%0: i32) -> i32 {
    %3 = test.constant 11 : i32;
    %4 = test.constant 22 : i32;
    %5 = test.constant 0 : i32;
    %6 = test.neq %0, %5;
    %12, %13 = scf.if %6 then {
        %14, %15 = scf.index_switch %0 
        case 1 {
            scf.yield %3, %4 : (i32, i32);
        }
        case 2 {
            scf.yield %3, %4 : (i32, i32);
        }
        default {
            scf.yield %3, %4 : (i32, i32);
        } : (i32, i32);
