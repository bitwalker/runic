builtin.function public extern("C") @index_switch_remove_unused_results(%0: i32) -> i32 {
    %1 = test.constant 1 : i32;
    %2 = test.constant 2 : i32;
    %3 = test.constant 3 : i32;
    %4 = test.constant 4 : i32;
    %5, %6 = scf.index_switch %0
    case 1 {
        scf.yield %1, %2 : (i32, i32);
    }
    default {
        scf.yield %3, %4 : (i32, i32);
    } : (i32, i32);
    builtin.ret %6 : (i32);
};
